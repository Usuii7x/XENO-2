-- =============================[ FEATURE: NO RECOIL/SPREAD ]=============================
local function SetupWeaponMods()
    if not Settings.NoRecoil and not Settings.NoSpread and not Settings.FastFireRate and not Settings.InfiniteAmmo then
        return
    end
    
    local mt = getrawmetatable(game)
    local oldIndex = mt.__index
    setreadonly(mt, false)
    
    mt.__index = newcclosure(function(self, key)
        if Settings.NoRecoil and (key == "Recoil" or key == "CameraRecoil") then
            return Vector2.new(0, 0)
        end
        if Settings.NoSpread and key == "Spread" then
            return 0
        end
        if Settings.FastFireRate and key == "FireRate" then
            return 0.01
        end
        if Settings.InfiniteAmmo and key == "Ammo" then
            return 999
        end
        return oldIndex(self, key)
    end)
    
    setreadonly(mt, true)
end

