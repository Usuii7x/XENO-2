-- Loop do ESP (Básico)
task.spawn(function()
    local highlighters = {}
    while task.wait(1) do
        if not state.ESP then
            for _, hl in pairs(highlighters) do hl:Destroy() end
            highlighters = {}
            continue
        end
        
        for _, obj in pairs(workspace:GetChildren()) do
            if obj:IsA("Model") and obj:FindFirstChild("Humanoid") then
                local isEnemy = not game:GetService("Players"):FindFirstChild(obj.Name)
                if isEnemy or obj.Name ~= Player.Name then
                    if not obj:FindFirstChild("ESPBox") then
                        local hl = Instance.new("BoxHandleAdornment")
                        hl.Name = "ESPBox"
                        hl.Adornee = obj
                        hl.Color3 = isEnemy and Color3.fromRGB(255, 0, 0) or Color3.fromRGB(0, 255, 0)
                        hl.Transparency = 0.5
                        hl.Size = Vector3.new(4, 4, 4)
                        hl.AlwaysOnTop = true
                        hl.ZIndex = 10
                        hl.Parent = obj
                        table.insert(highlighters, hl)
                    end
                end
            end
        end
    end
end)

