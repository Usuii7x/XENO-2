local function ToggleFPSBooster(state)
    if state then
        settings().Rendering.QualityLevel = 1
        if Lighting:FindFirstChild("Bloom") then Lighting.Bloom.Enabled = false end
        if Lighting:FindFirstChild("ColorCorrection") then Lighting.ColorCorrection.Enabled = false end
        if Lighting:FindFirstChild("SunRays") then Lighting.SunRays.Enabled = false end
        
        workspace.DescendantAdded:Connect(function(desc)
            if desc:IsA("ParticleEmitter") or desc:IsA("Smoke") or desc:IsA("Fire") then
                desc.Enabled = false
            end
        end)
    else
        settings().Rendering.QualityLevel = 10
        if Lighting:FindFirstChild("Bloom") then Lighting.Bloom.Enabled = true end
        if Lighting:FindFirstChild("ColorCorrection") then Lighting.ColorCorrection.Enabled = true end
        if Lighting:FindFirstChild("SunRays") then Lighting.SunRays.Enabled = true end
    end
end

-- =============================[ FEATURE: KILL AURA ]=============================
local KillAuraConnection = nil
local function StartKillAura()
    if not Settings.KillAura then return end
    
    if KillAuraConnection then KillAuraConnection:Disconnect() end
    
    KillAuraConnection = RunService.RenderStepped:Connect(function()
        local character = Player.Character
        local rootPart = character and character:FindFirstChild("HumanoidRootPart")
        if not rootPart then return end
        
        for _, target in ipairs(Workspace:GetDescendants()) do
            if target:IsA("Model") and target:FindFirstChild("Humanoid") and target ~= character then
                local targetRoot = target:FindFirstChild("HumanoidRootPart") or target:FindFirstChild("Torso")
                if targetRoot then
                    local distance = (rootPart.Position - targetRoot.Position).Magnitude
                    if distance <= Settings.KillAuraRange then
                        local humanoid = target.Humanoid
                        if humanoid.Health > 0 then
                            humanoid.Health = 0
                        end
                    end
                end
            end
        end
    end)
end

