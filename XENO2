-- ==================== FUNÇÕES DE EXPLOIT ====================

local function KillAura()
    while getgenv().XenoSettings.KillAura do
        task.wait(0.1)
        pcall(function()
            for _, zombie in ipairs(Workspace.Zombies:GetChildren()) do
                if zombie:FindFirstChild("Humanoid") and zombie.Humanoid.Health > 0 then
                    local dist = (zombie.HumanoidRootPart.Position - Character.HumanoidRootPart.Position).Magnitude
                    if dist < 25 then -- alcance da aura
                        zombie.Humanoid:TakeDamage(9999)
                    end
                end
            end
        end)
    end
end

local function OneHitKill()
    while getgenv().XenoSettings.OneHitKill do
        task.wait(0.2)
        pcall(function()
            for _, zombie in ipairs(Workspace.Zombies:GetChildren()) do
                if zombie:FindFirstChild("Humanoid") then
                    zombie.Humanoid.Health = 1
                end
            end
        end)
    end
end

local function FreezeEnemies()
    while getgenv().XenoSettings.FreezeEnemies do
        task.wait(0.5)
        pcall(function()
            for _, zombie in ipairs(Workspace.Zombies:GetChildren()) do
                if zombie:FindFirstChild("Humanoid") then
                    zombie.Humanoid.WalkSpeed = 0
                    zombie.Humanoid.JumpPower = 0
                end
            end
        end)
    end
end

local function AntiAFK()
    while getgenv().XenoSettings.AntiAFK do
        task.wait(30)
        pcall(function()
            game:GetService("VirtualUser"):Button2Down(Vector2.new(0,0), Workspace.CurrentCamera.CFrame)
            task.wait(0.1)
            game:GetService("VirtualUser"):Button2Up(Vector2.new(0,0), Workspace.CurrentCamera.CFrame)
        end)
    end
end

local function AutoUnlockDoors()
    while getgenv().XenoSettings.AutoUnlockDoors do
        task.wait(1)
        pcall(function()
            for _, door in ipairs(Workspace:GetDescendants()) do
                if door.Name:lower():find("door") or door.Name == "Gate" then
                    if door:FindFirstChild("Lock") then
                        door.Lock:Destroy()
                    end
                    if door:FindFirstChild("Value") then
                        door.Value.Value = false
                    end
                end
            end
        end)
    end
end

local function AutoBuyPerks()
    while getgenv().XenoSettings.AutoBuyPerks do
        task.wait(2)
        pcall(function()
            -- Ajuste conforme os nomes reais do jogo
            for _, perk in ipairs({"Juggernog", "SpeedCola", "QuickRevive", "DoubleTap"}) do
                local buyPart = Workspace:FindFirstChild(perk, true)
                if buyPart and buyPart:FindFirstChild("ProximityPrompt") then
                    fireproximityprompt(buyPart.ProximityPrompt)
                end
            end
        end)
    end
end

local function AutoUpgradeWeapons()
    while getgenv().XenoSettings.AutoUpgradeWeapons do
        task.wait(3)
        pcall(function()
            -- Exemplo genérico - ajuste conforme o jogo
            local upgradeMachine = Workspace:FindFirstChild("PackAPunch", true) or Workspace:FindFirstChild("UpgradeStation", true)
            if upgradeMachine and upgradeMachine:FindFirstChild("ProximityPrompt") then
                fireproximityprompt(upgradeMachine.ProximityPrompt)
            end
        end)
    end
end

local function TeleportToSafe()
    pcall(function()
        local safeSpots = {
            Vector3.new(0, 50, 0),   -- ajuste conforme mapa
            Vector3.new(100, 20, 100),
            Vector3.new(-150, 30, -80)
        }
        Character.HumanoidRootPart.CFrame = CFrame.new(safeSpots[math.random(1, #safeSpots)])
    end)
end

