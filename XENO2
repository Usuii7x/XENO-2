local function Initialize()
    -- Carregar settings
    pcall(function() LoadSettings() end)
    
    -- Criar UI
    pcall(function() CreateUI() end)
    
    -- Notificação de boas-vindas
    wait(1)
    CreateNotification("Phantom Hub", "Welcome " .. Player.Name .. "! Press " .. MenuKeybind.Name .. " to toggle menu", 4, "success")
end

-- Executar
local Success, Error = pcall(Initialize)
if not Success then
    warn("Failed to load Phantom Hub: " .. tostring(Error))
    -- Fallback notification
    game:GetService("StarterGui"):SetCore("SendNotification", {
        Title = "Phantom Hub",
        Text = "Failed to load: " .. tostring(Error),
        Duration = 5
    })
end
