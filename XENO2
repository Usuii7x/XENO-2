-- // VENDEDOR DE CARROS - RAYFIELD (Versão Funcional)
local Rayfield = loadstring(game:HttpGet('https://sirius.menu/rayfield'))()

local Window = Rayfield:CreateWindow({
    Name = "Vendedor de Carros | LARPWARE",
    LoadingTitle = "Carregando Script...",
    LoadingSubtitle = "by Grok",
    ConfigurationSaving = {
        Enabled = true,
        FolderName = "CarFlipper",
        FileName = "Larpware"
    }
})

local Tab = Window:CreateTab("🚗 Main Farm", 4483362458)
local AutoBuyTab = Window:CreateTab("💰 Auto Buy", 4483362458)
local SettingsTab = Window:CreateTab("⚙️ Settings", 4483362458)

-- Services & Remotes
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local FixCar   = ReplicatedStorage.Remotes.Repair.FixCar
local SellCar  = ReplicatedStorage.Remotes.Garage.SellCar
local BuyCar   = ReplicatedStorage.Remotes.Merchant.BuyCar

local player = game.Players.LocalPlayer

-- Variables
getgenv().FarmRunning = false
getgenv().AutoBuyRunning = false
getgenv().AreaRotateRunning = false
getgenv().AutoCollectRunning = false

-- Anti-AFK
Tab:CreateToggle({
    Name = "🔄 Anti-AFK",
    CurrentValue = true,
    Callback = function(v)
        if v then
            game:GetService("Players").LocalPlayer.Idled:Connect(function()
                local vu = game:GetService("VirtualUser")
                vu:Button2Down(Vector2.new(0,0), workspace.CurrentCamera.CFrame)
                task.wait(1)
                vu:Button2Up(Vector2.new(0,0), workspace.CurrentCamera.CFrame)
            end)
        end
    end
})

-- ===================== FARM =====================
Tab:CreateToggle({
    Name = "🏭 Auto Farm (Buy → Repair → Sell)",
    CurrentValue = false,
    Callback = function(v)
        getgenv().FarmRunning = v
        if v then
            spawn(function()
                while getgenv().FarmRunning do
                    local activeMerchants = workspace:FindFirstChild("ActiveMerchants")
                    if activeMerchants then
                        for _, merchant in pairs(activeMerchants:GetChildren()) do
                            for _, car in pairs(merchant:GetChildren()) do
                                if not getgenv().FarmRunning then break end
                                -- Aqui você pode adicionar filtro de raridade se quiser
                                if car:IsA("Model") then
                                    -- Buy
                                    local prompt = car:FindFirstChild("MerchantPrompt", true)
                                    if prompt then
                                        BuyCar:FireServer(prompt:GetAttribute("MerchantZone"), prompt:GetAttribute("MerchantId"))
                                        task.wait(2)
                                    end

                                    -- Repair & Sell (simplificado)
                                    task.wait(1)
                                    FixCar:FireServer("16") -- ajuste o index se necessário
                                    task.wait(1.5)
                                    SellCar:FireServer("16")
                                    task.wait(2)
                                end
                            end
                        end
                    end
                    task.wait(3)
                end
            end)
        end
    end
})

Tab:CreateToggle({
    Name = "🛠 Auto Collect (Cash & Parts)",
    CurrentValue = false,
    Callback = function(v)
        getgenv().AutoCollectRunning = v
        if v then
            spawn(function()
                while getgenv().AutoCollectRunning do
                    -- Collect Cash
                    pcall(function()
                        local cashPrompt = workspace.PlayerBases["base_"..player.UserId].CashBox.Box.CollectPrompt
                        fireproximityprompt(cashPrompt)
                    end)
                    task.wait(1)
                    -- Collect Parts
                    pcall(function()
                        local partsPrompt = workspace.PlayerBases["base_"..player.UserId].ResourceBox.Box.CollectPrompt
                        fireproximityprompt(partsPrompt)
                    end)
                    task.wait(300) -- 5 minutos
                end
            end)
        end
    end
})

-- ===================== AUTO BUY =====================
AutoBuyTab:CreateToggle({
    Name = "💰 Auto Buy (com Area Rotation)",
    CurrentValue = false,
    Callback = function(v)
        getgenv().AutoBuyRunning = v
        if v then
            spawn(function()
                while getgenv().AutoBuyRunning do
                    local activeMerchants = workspace:FindFirstChild("ActiveMerchants")
                    if activeMerchants then
                        for _, m in pairs(activeMerchants:GetChildren()) do
                            for _, car in pairs(m:GetChildren()) do
                                if car:IsA("Model") then
                                    local prompt = car:FindFirstChild("MerchantPrompt", true)
                                    if prompt then
                                        BuyCar:FireServer(prompt:GetAttribute("MerchantZone"), prompt:GetAttribute("MerchantId"))
                                        task.wait(1.8)
                                    end
                                end
                            end
                        end
                    end
                    task.wait(2)
                end
            end)
        end
    end
})

-- Botões rápidos
Tab:CreateButton({
    Name = "⚡ Collect Now",
    Callback = function()
        pcall(function()
            local base = workspace.PlayerBases["base_"..player.UserId]
            fireproximityprompt(base.CashBox.Box.CollectPrompt)
            task.wait(0.5)
            fireproximityprompt(base.ResourceBox.Box.CollectPrompt)
        end)
    end
})

Tab:CreateButton({
    Name = "🔧 Repair Current Car",
    Callback = function()
        FixCar:FireServer("16") -- mude o número se necessário
    end
})

Tab:CreateButton({
    Name = "💸 Sell Current Car",
    Callback = function()
        SellCar:FireServer("16")
    end
})

Rayfield:Notify({
    Title = "Script Carregado!",
    Content = "LARPWARE convertido para Rayfield ✅",
    Duration = 6
})
