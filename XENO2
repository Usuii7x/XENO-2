local AutoTaskEnabled = false

TaskTab:CreateToggle({
   Name = "📝 Auto Complete Task",
   CurrentValue = false,
   Flag = "AutoTask",
   Callback = function(Value)
      AutoTaskEnabled = Value
      if Value then
         local function CompleteTasks()
            if not AutoTaskEnabled then return end
            -- Simular completar tarefas (adaptar ao jogo específico)
            local tasks = game:GetService("ReplicatedStorage"):FindFirstChild("Tasks")
            if tasks then
               for _, task in ipairs(tasks:GetChildren()) do
                  if task:IsA("RemoteEvent") then
                     task:FireServer(task.Name)
                  end
               end
            end
         end
         spawn(function()
            while AutoTaskEnabled do
               CompleteTasks()
               wait(0.5)
            end
         end)
      end
   end
})

