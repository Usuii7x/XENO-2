    dropdownBtn.BackgroundColor3 = Color3.fromRGB(50, 50, 60)
    dropdownBtn.BorderSizePixel = 0
    dropdownBtn.Size = UDim2.new(0.4, 0, 0.8, 0)
    dropdownBtn.Position = UDim2.new(0.55, 0, 0.1, 0)
    dropdownBtn.Text = config.CurrentOption or config.Options[1]
    dropdownBtn.TextColor3 = Color3.fromRGB(255, 255, 255)
    dropdownBtn.TextSize = 13
    dropdownBtn.Font = Enum.Font.GothamMedium
    
    local dropdownCorner = Instance.new("UICorner")
    dropdownCorner.Parent = dropdownBtn
    
    local dropdownVisible = false
    local optionButtons = {}
    
    dropdownBtn.MouseButton1Click:Connect(function()
        dropdownVisible = not dropdownVisible
        for _, btn in pairs(optionButtons) do
            btn.Visible = dropdownVisible
        end
    end)
    
    for i, option in ipairs(config.Options) do
        local optBtn = Instance.new("TextButton")
        optBtn.Parent = frame
        optBtn.BackgroundColor3 = Color3.fromRGB(45, 45, 55)
        optBtn.BorderSizePixel = 0
        optBtn.Size = UDim2.new(0.4, 0, 0.8, 0)
        optBtn.Position = UDim2.new(0.55, 0, 0.1 + i * 0.8, 0)
        optBtn.Text = option
        optBtn.TextColor3 = Color3.fromRGB(200, 200, 200)
        optBtn.TextSize = 13
        optBtn.Font = Enum.Font.GothamMedium
        optBtn.Visible = false
        
        local optCorner = Instance.new("UICorner")
        optCorner.Parent = optBtn
        
        optBtn.MouseButton1Click:Connect(function()
            dropdownBtn.Text = option
            dropdownVisible = false
            for _, btn in pairs(optionButtons) do
                btn.Visible = false
            end
            if config.Callback then
                config.Callback(option)
            end
        end)
        
        table.insert(optionButtons, optBtn)
    end
    
    return {
        SetValue = function(value)
            dropdownBtn.Text = value
        end
    }
end

local function CreateSlider(parent, config)
    local frame = Instance.new("Frame")
    frame.Parent = parent
    frame.BackgroundColor3 = Color3.fromRGB(35, 35, 45)
    frame.BorderSizePixel = 0
    frame.Size = UDim2.new(1, -20, 0, 45)
    frame.Position = UDim2.new(0, 10, 0, (#parent:GetChildren() - 1) * 45 + 5)
    
    local frameCorner = Instance.new("UICorner")
    frameCorner.Parent = frame
    
    local label = Instance.new("TextLabel")
    label.Parent = frame
    label.BackgroundTransparency = 1
    label.Size = UDim2.new(0.4, 0, 0.5, 0)
    label.Position = UDim2.new(0, 10, 0, 0)
    label.Text = config.Name
    label.TextColor3 = Color3.fromRGB(220, 220, 220)
    label.TextSize = 14
    label.Font = Enum.Font.GothamMedium
    label.TextXAlignment = Enum.TextXAlignment.Left
    
    local valueLabel = Instance.new("TextLabel")
    valueLabel.Parent = frame
    valueLabel.BackgroundTransparency = 1
    valueLabel.Size = UDim2.new(0.2, 0, 0.5, 0)
    valueLabel.Position = UDim2.new(0.75, 0, 0, 0)
    valueLabel.Text = tostring(config.CurrentValue or config.Range[1])
    valueLabel.TextColor3 = Color3.fromRGB(150, 100, 200)
    valueLabel.TextSize = 14
    valueLabel.Font = Enum.Font.GothamBold
    
    local slider = Instance.new("Frame")
    slider.Parent = frame
    slider.BackgroundColor3 = Color3.fromRGB(60, 60, 70)
    slider.BorderSizePixel = 0
    slider.Size = UDim2.new(0.7, 0, 0.25, 0)
    slider.Position = UDim2.new(0.1, 0, 0.6, 0)
    
    local sliderCorner = Instance.new("UICorner")
    sliderCorner.Parent = slider
    
    local fill = Instance.new("Frame")
    fill.Parent = slider
    fill.BackgroundColor3 = Color3.fromRGB(120, 0, 180)
    fill.BorderSizePixel = 0
    fill.Size = UDim2.new(0, 0, 1, 0)
    
    local fillCorner = Instance.new("UICorner")
    fillCorner.Parent = fill
    
    local min = config.Range[1] or 0
    local max = config.Range[2] or 100
    local current = config.CurrentValue or min
    local increment = config.Increment or 1
    
    fill.Size = UDim2.new((current - min) / (max - min), 0, 1, 0)
    valueLabel.Text = tostring(current)
    
    local dragging = false
    
    slider.InputBegan:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1 then
            dragging = true
            local mousePos = input.Position.X
            local sliderPos = slider.AbsolutePosition.X
            local sliderSize = slider.AbsoluteSize.X
            local percent = math.clamp((mousePos - sliderPos) / sliderSize, 0, 1)
            local value = math.floor((min + percent * (max - min)) / increment) * increment
            value = math.clamp(value, min, max)
            current = value
            fill.Size = UDim2.new(percent, 0, 1, 0)
            valueLabel.Text = tostring(value)
            if config.Callback then
                config.Callback(value)
            end
        end
    end)
    
    slider.InputChanged:Connect(function(input)
        if dragging and input.UserInputType == Enum.UserInputType.MouseMovement then
            local mousePos = input.Position.X
            local sliderPos = slider.AbsolutePosition.X
            local sliderSize = slider.AbsoluteSize.X
            local percent = math.clamp((mousePos - sliderPos) / sliderSize, 0, 1)
            local value = math.floor((min + percent * (max - min)) / increment) * increment
            value = math.clamp(value, min, max)
            current = value
            fill.Size = UDim2.new(percent, 0, 1, 0)
            valueLabel.Text = tostring(value)
            if config.Callback then
                config.Callback(value)
            end
        end
    end)
    
    UserInputService.InputEnded:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1 then
            dragging = false
        end
    end)
    
    return {
        SetValue = function(value)
            value = math.clamp(value, min, max)
            current = value
            local percent = (value - min) / (max - min)
            fill.Size = UDim2.new(percent, 0, 1, 0)
            valueLabel.Text = tostring(value)
        end
    }
end

