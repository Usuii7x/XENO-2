function spawnESP()
    for _, v in pairs(game:GetService("Players"):GetPlayers()) do
        if v ~= player then
            local box = Instance.new("BoxHandleAdornment")
            box.Name = "ESP_BOX"
            box.Adornee = v.Character
            box.Size = Vector3.new(3, 5, 3)
            box.Color3 = Color3.new(1, 0, 0)
            box.AlwaysOnTop = true
            box.Parent = v.Character
            
            local text = Instance.new("BillboardGui")
            text.Name = "ESP_TEXT"
            text.Adornee = v.Character.Head
            text.Size = UDim2.new(0, 200, 0, 50)
            text.StudsOffset = Vector3.new(0, 2, 0)
            local label = Instance.new("TextLabel", text)
            label.Text = v.Name .. " | " .. math.floor((v.Character.HumanoidRootPart.Position - player.Character.HumanoidRootPart.Position).magnitude) .. "m"
            label.TextColor3 = Color3.new(1, 1, 1)
            label.BackgroundTransparency = 1
            text.Parent = v.Character.Head
        end
    end
end

function removeESP()
    for _, v in pairs(game:GetService("Players"):GetPlayers()) do
        if v.Character then
            for _, obj in pairs(v.Character:GetDescendants()) do
                if obj.Name == "ESP_BOX" or obj.Name == "ESP_TEXT" then
                    obj:Destroy()
                end
            end
        end
    end
end

