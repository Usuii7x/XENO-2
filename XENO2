-- =============================[ FEATURE: REMOVE ZOMBIES ]=============================
local function RemoveZombies()
    local count = 0
    for _, obj in ipairs(Workspace:GetDescendants()) do
        if obj:IsA("Model") and obj.Name:lower():match("zombie") then
            if obj:FindFirstChild("Humanoid") then
                obj.Humanoid.Health = 0
                count = count + 1
            end
        end
    end
    CreateNotification("Zombies Removed", "Removed " .. count .. " zombies", 2, "success")
end

