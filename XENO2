if not game:IsLoaded() then game.Loaded:Wait() end

-- // Variáveis globais
local Players = game:GetService("Players")
local RunService = game:GetService("RunService")
local UserInputService = game:GetService("UserInputService")
local LocalPlayer = Players.LocalPlayer
local Camera = workspace.CurrentCamera
local Mouse = LocalPlayer:GetMouse()

-- // Configurações do usuário
local Settings = {
    Aimbot = {
        Enabled = false,
        Smooth = 0.3,
        FOV = 120,
        TargetPart = "Head", -- Head, Chest, Random
        Priority = "Distance" -- Distance, Angle
    },
    InfiniteAmmo = {
        Enabled = false,
        NoReload = true
    },
    ESP = {
        Enabled = false,
        Box = true,
        Lines = true,
        Name = true,
        Distance = true,
        HealthBar = true,
        Skeleton = false,
        TeamColors = true,
        VisibleColor = Color3.fromRGB(255, 0, 0),
        HiddenColor = Color3.fromRGB(100, 100, 100)
    },
    NoRecoil = false,
    NoSpread = false
}

-- // Anti-Ban simples (ofuscação)
local AntiBan = {
    Delay = function(t)
        local start = tick()
        while tick() - start < t do
            game:GetService("RunService").Stepped:Wait()
        end
    end,
    RandomWait = function()
        wait(math.random(0.05, 0.15))
    end
}

-- // Utilitários
local function GetClosestPlayer()
    local closest = nil
    local closestDistance = Settings.Aimbot.Priority == "Distance" and math.huge or math.huge
    
    for _, player in ipairs(Players:GetPlayers()) do
        if player ~= LocalPlayer and player.Character and player.Character:FindFirstChild("Humanoid") and player.Character.Humanoid.Health > 0 then
            local character = player.Character
            local headPos = character:FindFirstChild("Head") and character.Head.Position or character.PrimaryPart.Position
            local screenPos, onScreen = Camera:WorldToScreenPoint(headPos)
            
            if onScreen then
                local distance = (headPos - Camera.CFrame.Position).Magnitude
                local angle = (Vector2.new(Mouse.X, Mouse.Y) - Vector2.new(screenPos.X, screenPos.Y)).Magnitude
                
                if Settings.Aimbot.Priority == "Distance" then
                    if distance < closestDistance then
                        closestDistance = distance
                        closest = player
                    end
                else -- Angle
                    if angle < closestDistance and angle <= Settings.Aimbot.FOV then
                        closestDistance = angle
                        closest = player
                    end
                end
            end
        end
    end
    
    return closest
end

-- // Aimbot
local AimbotActive = false
local function UpdateAimbot()
    if not Settings.Aimbot.Enabled then return end
    
    local target = GetClosestPlayer()
    if target and target.Character then
        local targetPart
        if Settings.Aimbot.TargetPart == "Head" then
            targetPart = target.Character:FindFirstChild("Head")
        elseif Settings.Aimbot.TargetPart == "Chest" then
            targetPart = target.Character:FindFirstChild("UpperTorso") or target.Character:FindFirstChild("Torso")
        else -- Random
            local parts = {"Head", "UpperTorso", "LowerTorso"}
            targetPart = target.Character:FindFirstChild(parts[math.random(1, #parts)])
        end
        
        if targetPart then
            local targetPos = targetPart.Position
            local cameraPos = Camera.CFrame.Position
            local direction = (targetPos - cameraPos).Unit
            local newCFrame = CFrame.new(cameraPos, cameraPos + direction)
            
            -- Smooth AIM
            if Settings.Aimbot.Smooth > 0 then
                Camera.CFrame = Camera.CFrame:Lerp(newCFrame, Settings.Aimbot.Smooth)
            else
                Camera.CFrame = newCFrame
            end
        end
    end
end

-- // Munição Infinita
local function HandleInfiniteAmmo()
    if not Settings.InfiniteAmmo.Enabled then return end
    
    local tool = LocalPlayer.Character and LocalPlayer.Character:FindFirstChildOfClass("Tool")
    if tool then
        local ammoCount = tool:FindFirstChild("AmmoCount")
        if ammoCount then
            ammoCount.Value = math.huge
        end
        
        if Settings.InfiniteAmmo.NoReload then
            local reloadEvent = tool:FindFirstChild("ReloadEvent")
            if reloadEvent then
                reloadEvent:FireServer()
                AntiBan.RandomWait()
            end
        end
    end
end

-- // ESP
local ESPObjects = {}
local function CreateESP(player)
    if not player or player == LocalPlayer then return end
    
    local espData = {
        Box = nil,
        Line = nil,
        Name = nil,
        Distance = nil,
        HealthBar = nil
    }
    
    -- Cria os elementos de desenho
    local function UpdateESP()
        if not Settings.ESP.Enabled or not player.Character then
            for _, v in pairs(espData) do
                if v then v:Remove() end
            end
            return
        end
        
        local character = player.Character
        local humanoid = character:FindFirstChild("Humanoid")
        if not humanoid or humanoid.Health <= 0 then return end
        
        local rootPart = character:FindFirstChild("HumanoidRootPart") or character.PrimaryPart
        if not rootPart then return end
        
        local screenPos, onScreen = Camera:WorldToScreenPoint(rootPart.Position)
        if not onScreen then return end
        
        local espColor = Settings.ESP.TeamColors and (player.Team == LocalPlayer.Team and Color3.fromRGB(0, 255, 0) or Color3.fromRGB(255, 0, 0)) or Settings.ESP.VisibleColor
        
        -- Box ESP
        if Settings.ESP.Box then
            if not espData.Box then
                espData.Box = Drawing.new("Square")
                espData.Box.Thickness = 2
                espData.Box.Filled = false
            end
            local size = 3
            espData.Box.Position = Vector2.new(screenPos.X - size, screenPos.Y - size)
            espData.Box.Size = Vector2.new(size * 2, size * 2)
            espData.Box.Color = espColor
            espData.Box.Visible = true
        elseif espData.Box then
            espData.Box.Visible = false
        end
        
        -- Lines ESP
        if Settings.ESP.Lines then
            if not espData.Line then
                espData.Line = Drawing.new("Line")
                espData.Line.Thickness = 1
            end
            espData.Line.From = Vector2.new(Camera.ViewportSize.X / 2, Camera.ViewportSize.Y)
            espData.Line.To = Vector2.new(screenPos.X, screenPos.Y)
            espData.Line.Color = espColor
            espData.Line.Visible = true
        elseif espData.Line then
            espData.Line.Visible = false
        end
        
        -- Name ESP
        if Settings.ESP.Name then
            if not espData.Name then
                espData.Name = Drawing.new("Text")
                espData.Name.Size = 14
                espData.Name.Center = true
            end
            espData.Name.Text = player.Name
            espData.Name.Position = Vector2.new(screenPos.X, screenPos.Y - 30)
            espData.Name.Color = espColor
            espData.Name.Visible = true
        elseif espData.Name then
            espData.Name.Visible = false
        end
        
        -- Distance ESP
        if Settings.ESP.Distance then
            if not espData.Distance then
                espData.Distance = Drawing.new("Text")
                espData.Distance.Size = 12
                espData.Distance.Center = true
            end
            local distance = (rootPart.Position - Camera.CFrame.Position).Magnitude
            espData.Distance.Text = string.format("%.1fm", distance)
            espData.Distance.Position = Vector2.new(screenPos.X, screenPos.Y + 10)
            espData.Distance.Color = espColor
            espData.Distance.Visible = true
        elseif espData.Distance then
            espData.Distance.Visible = false
        end
        
        -- Health Bar ESP
        if Settings.ESP.HealthBar then
            if not espData.HealthBar then
                espData.HealthBar = Drawing.new("Line")
                espData.HealthBar.Thickness = 4
            end
            local healthPercent = humanoid.Health / humanoid.MaxHealth
            local barLength = 50 * healthPercent
            espData.HealthBar.From = Vector2.new(screenPos.X - 25, screenPos.Y - 20)
            espData.HealthBar.To = Vector2.new(screenPos.X - 25 + barLength, screenPos.Y - 20)
            espData.HealthBar.Color = Color3.fromRGB(0, 255, 0)
            espData.HealthBar.Visible = true
        elseif espData.HealthBar then
            espData.HealthBar.Visible = false
        end
    end
    
    -- Loop de atualização do ESP
    coroutine.wrap(function()
        while player and player.Parent do
            UpdateESP()
            RunService.RenderStepped:Wait()
        end
        for _, v in pairs(espData) do
            if v then v:Remove() end
        end
    end)()
end

-- // Interface Vulcan UI
local VulcanUI = {
