-- Sistema de teclas
local function GetKeyCode(keyName)
    local keyMap = {
        ["Botão Direito"] = Enum.UserInputType.MouseButton2,
        ["Botão Esquerdo"] = Enum.UserInputType.MouseButton1,
        ["Botão do Meio"] = Enum.UserInputType.MouseButton3,
        ["Q"] = Enum.KeyCode.Q,
        ["E"] = Enum.KeyCode.E,
        ["R"] = Enum.KeyCode.R,
        ["F"] = Enum.KeyCode.F,
        ["C"] = Enum.KeyCode.C,
        ["X"] = Enum.KeyCode.X,
        ["Z"] = Enum.KeyCode.Z,
        ["ALT"] = Enum.KeyCode.LeftAlt,
        ["CTRL"] = Enum.KeyCode.LeftControl,
        ["SHIFT"] = Enum.KeyCode.LeftShift,
    }
    return keyMap[keyName] or Enum.UserInputType.MouseButton2
end

-- Detectar entrada do usuário
UserInputService.InputBegan:Connect(function(input, gameProcessed)
    if gameProcessed then return end
    
    local aimbotKey = GetKeyCode(Settings.AimbotKey)
    
    -- Verificar se a tecla pressionada é a configurada
    local isAimKey = false
    
    if Settings.AimbotKey:find("Botão") then
        isAimKey = input.UserInputType == aimbotKey
    else
        isAimKey = input.KeyCode == aimbotKey
    end
    
    if isAimKey then
        if Window.Flags.AimbotToggle then
            Settings.AimbotEnabled = true
            isAiming = true
        end
    end
end)

UserInputService.InputEnded:Connect(function(input)
    local aimbotKey = GetKeyCode(Settings.AimbotKey)
    
    local isAimKey = false
    
    if Settings.AimbotKey:find("Botão") then
        isAimKey = input.UserInputType == aimbotKey
    else
        isAimKey = input.KeyCode == aimbotKey
    end
    
    if isAimKey then
        Settings.AimbotEnabled = false
        isAiming = false
        currentTarget = nil
    end
end)

