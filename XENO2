-- Fly (N-FLY modernizado)
local flyEnabled = false
local flySpeed = 1
local bodyVelocity, bodyGyro

local function StartFly()
    local playerChar = LocalPlayer.Character
    local humanoid = playerChar and playerChar:FindFirstChild("Humanoid")
    if not humanoid then return end
    
    flyEnabled = true
    humanoid.PlatformStand = true
    
    bodyVelocity = Instance.new("BodyVelocity")
    bodyVelocity.Velocity = Vector3.new(0,0,0)
    bodyVelocity.MaxForce = Vector3.new(10000,10000,10000)
    bodyVelocity.Parent = playerChar.PrimaryPart
    
    bodyGyro = Instance.new("BodyGyro")
    bodyGyro.MaxTorque = Vector3.new(10000,10000,10000)
    bodyGyro.Parent = playerChar.PrimaryPart
    
    local camera = Workspace.CurrentCamera
    
    RunService:BindToRenderStep("FlyControl", Enum.RenderPriority.Camera.Value, function()
        if not flyEnabled or not playerChar or not playerChar.PrimaryPart then
            RunService:UnbindFromRenderStep("FlyControl")
            return
        end
        
        local moveDirection = Vector3.new()
        local forward = camera.CFrame.LookVector
        local right = camera.CFrame.RightVector
        local up = camera.CFrame.UpVector
        
        if UserInputService:IsKeyDown(Enum.KeyCode.W) then moveDirection = moveDirection + forward end
        if UserInputService:IsKeyDown(Enum.KeyCode.S) then moveDirection = moveDirection - forward end
        if UserInputService:IsKeyDown(Enum.KeyCode.D) then moveDirection = moveDirection + right end
        if UserInputService:IsKeyDown(Enum.KeyCode.A) then moveDirection = moveDirection - right end
        if UserInputService:IsKeyDown(Enum.KeyCode.Space) then moveDirection = moveDirection + up end
        if UserInputService:IsKeyDown(Enum.KeyCode.LeftControl) then moveDirection = moveDirection - up end
        
        if moveDirection.Magnitude > 0 then
            moveDirection = moveDirection.Unit * flySpeed * 50
        end
        
        if bodyVelocity then
            bodyVelocity.Velocity = moveDirection
        end
        if bodyGyro then
            bodyGyro.CFrame = camera.CFrame
        end
    end)
end

local function StopFly()
    flyEnabled = false
    RunService:UnbindFromRenderStep("FlyControl")
    local playerChar = LocalPlayer.Character
    local humanoid = playerChar and playerChar:FindFirstChild("Humanoid")
    if humanoid then
        humanoid.PlatformStand = false
    end
    if bodyVelocity then bodyVelocity:Destroy() end
    if bodyGyro then bodyGyro:Destroy() end
end

