local function SwitchTab(tabName)
    for name, content in pairs(TabContents) do
        content.Visible = (name == tabName)
        if name == tabName then
            TabButtons[name].BackgroundColor3 = Color3.fromRGB(80, 0, 120)
            TabButtons[name].TextColor3 = Color3.fromRGB(255, 255, 255)
        else
            TabButtons[name].BackgroundColor3 = Color3.fromRGB(40, 40, 50)
            TabButtons[name].TextColor3 = Color3.fromRGB(200, 200, 200)
        end
    end
    CurrentTab = tabName
end

