local LocalPlayer = Players.LocalPlayer
local Mouse = LocalPlayer:GetMouse()

-- Variáveis
local aimbotEnabled = false
local aimbotKey = Enum.KeyCode.RightAlt -- Tecla padrão (botão direito do mouse)
local aimbotKeyType = "MouseButton2" -- RightClick
local fovRadius = 200
local smoothness = 5
local wallbangEnabled = false
local noRecoilEnabled = false
local instantReloadEnabled = false
local aimPart = "Head" -- Head, Torso, HumanoidRootPart
local selectedKey = "RightMouseButton"

-- Funções auxiliares
local function GetClosestPlayer()
    local closest = nil
    local shortestDistance = fovRadius
    
    for _, player in ipairs(Players:GetPlayers()) do
        if player ~= LocalPlayer and player.Character and player.Character:FindFirstChild("Humanoid") and player.Character.Humanoid.Health > 0 then
            local character = player.Character
            local aimTarget = character:FindFirstChild(aimPart) or character:FindFirstChild("HumanoidRootPart") or character:FindFirstChild("Head")
            
            if aimTarget then
                local screenPoint, onScreen = camera:WorldToScreenPoint(aimTarget.Position)
                if onScreen then
                    local mousePoint = Vector2.new(Mouse.X, Mouse.Y)
                    local distance = (Vector2.new(screenPoint.X, screenPoint.Y) - mousePoint).Magnitude
                    
                    if distance < shortestDistance then
                        shortestDistance = distance
                        closest = player
                    end
                end
            end
        end
    end
    
    return closest
end

local function AimAtPlayer(player)
    if not player or not player.Character then return end
    
    local targetPart = player.Character:FindFirstChild(aimPart) or player.Character:FindFirstChild("HumanoidRootPart") or player.Character:FindFirstChild("Head")
    if not targetPart then return end
    
    local camera = workspace.CurrentCamera
    local viewportPoint = camera:WorldToScreenPoint(targetPart.Position)
    
    if viewportPoint.Z > 0 then
        -- Movimento suave (smooth)
        local targetPosition = Vector2.new(viewportPoint.X, viewportPoint.Y)
        local currentPosition = Vector2.new(Mouse.X, Mouse.Y)
        local newPosition = currentPosition:Lerp(targetPosition, 1 / smoothness)
        
        mousemoverel(newPosition.X - currentPosition.X, newPosition.Y - currentPosition.Y)
    end
end

-- Função para verificar se a tecla está ativa
local function IsAimbotKeyPressed()
    if aimbotKeyType == "MouseButton2" then
        return UserInputService:IsMouseButtonPressed(Enum.UserInputType.MouseButton2)
    else
        return UserInputService:IsKeyDown(aimbotKey)
    end
end

-- Aimbot loop
RunService.RenderStepped:Connect(function()
    if aimbotEnabled and IsAimbotKeyPressed() then
        local target = GetClosestPlayer()
        if target then
            AimAtPlayer(target)
        end
    end
end)

-- Munição infinita
local function InfiniteAmmo()
    local playerScripts = LocalPlayer.PlayerScripts
    local weaponScript = playerScripts:FindFirstChild("WeaponScript") or playerScripts:FindFirstChild("GunScript")
    
    if weaponScript then
        local ammoVar = weaponScript:FindFirstChild("CurrentAmmo") or weaponScript:FindFirstChild("Ammo")
        if ammoVar then
            ammoVar.Value = 999
        end
    end
    
    -- Método alternativo: hook no evento de tiro
    local oldShoot
    local tools = LocalPlayer.Backpack:GetChildren()
    for _, tool in ipairs(tools) do
        if tool:IsA("Tool") and tool:FindFirstChild("ShootEvent") then
            oldShoot = tool.ShootEvent.OnServerEvent
            tool.ShootEvent.OnServerEvent = function(...)
                local args = {...}
                if args[2] and args[2].Ammo then
                    args[2].Ammo = 999
                end
                return oldShoot(...)
            end
        end
    end
end

-- No Recoil
local function NoRecoil()
    local camera = workspace.CurrentCamera
    local originalCFrame = camera.CFrame
    
    game:GetService("RunService").RenderStepped:Connect(function()
        if noRecoilEnabled then
            camera.CFrame = originalCFrame
        end
    end)
end

-- Instant Reload
local function InstantReload()
    local playerScripts = LocalPlayer.PlayerScripts
    local reloadScript = playerScripts:FindFirstChild("ReloadScript") or playerScripts:FindFirstChild("WeaponScript")
    
    if reloadScript then
        local reloadTime = reloadScript:FindFirstChild("ReloadTime")
        if reloadTime then
            reloadTime.Value = 0.1
        end
    end
end

-- Wallbang (atravessar paredes)
local function EnableWallbang()
    if wallbangEnabled then
        local bullet = workspace:FindFirstChild("Bullet") or game.ReplicatedStorage:FindFirstChild("Bullet")
        if bullet then
            bullet.CanCollide = false
        end
    end
end

-- Função para mudar tecla do aimbot
local function SetAimbotKey(keyName)
    selectedKey = keyName
    if keyName == "RightMouseButton" then
        aimbotKeyType = "MouseButton2"
    else
        aimbotKeyType = "Key"
        aimbotKey = Enum.KeyCode[keyName]
    end
end

