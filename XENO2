-- Função para criar notificações
local function Notify(Title, Content, Duration)
    if Vulcan and Vulcan.Notify then
        Vulcan:Notify({
            Title = Title,
            Content = Content,
            Duration = Duration or 3,
        })
    else
        game.StarterGui:SetCore("SendNotification", {
            Title = Title,
            Text = Content,
            Duration = Duration or 3,
        })
    end
end

