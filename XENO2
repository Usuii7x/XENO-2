    CurrentValue = getgenv().BloxFruitsVulcanConfig.FPSBoost,
    Callback = function(Value)
        getgenv().BloxFruitsVulcanConfig.FPSBoost = Value
        if Value then
            -- Remover decorações desnecessárias para melhorar FPS
            for _, v in pairs(workspace:GetDescendants()) do
                if v:IsA("Decal") or v:IsA("ParticleEmitter") then
                    v.Enabled = false
                end
            end
        end
    end,
})

MiscTab:CreateToggle({
    Name = "⬜ White Screen (Modo Performance)",
    CurrentValue = getgenv().BloxFruitsVulcanConfig.WhiteScreen,
    Callback = function(Value)
        getgenv().BloxFruitsVulcanConfig.WhiteScreen = Value
        if Value then
            -- Criar tela branca (melhora FPS drasticamente)
            local ws = Instance.new("Frame")
            ws.Size = UDim2.new(1, 0, 1, 0)
            ws.BackgroundColor3 = Color3.new(1, 1, 1)
            ws.Parent = game.Players.LocalPlayer.PlayerGui
        else
            -- Remover tela branca
            for _, v in pairs(game.Players.LocalPlayer.PlayerGui:GetChildren()) do
                if v:IsA("Frame") and v.BackgroundColor3 == Color3.new(1, 1, 1) then
                    v:Destroy()
                end
            end
        end
    end,
})

