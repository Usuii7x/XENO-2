-- Loop principal para atualizações constantes
spawn(function()
    while task.wait(1) do
        -- Atualizar estatísticas do player e aplicar configurações persistentes
        pcall(function()
            local player = game.Players.LocalPlayer
            if player and player.Character and player.Character:FindFirstChild("Humanoid") then
                local humanoid = player.Character.Humanoid
                -- Aplicar WalkSpeed e JumpPower em caso de respawn
                if getgenv().BloxFruitsVulcanConfig.WalkSpeed ~= 16 then
                    humanoid.WalkSpeed = getgenv().BloxFruitsVulcanConfig.WalkSpeed
                end
                if getgenv().BloxFruitsVulcanConfig.JumpPower ~= 50 then
                    humanoid.JumpPower = getgenv().BloxFruitsVulcanConfig.JumpPower
                end
            end
        end)
    end
end)

