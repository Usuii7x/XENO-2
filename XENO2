-- Função segura para encontrar eventos
local function FindRemoteEvent(pattern)
    for _, remote in pairs(replicatedStorage:GetDescendants()) do
        if remote:IsA("RemoteEvent") or remote:IsA("RemoteFunction") then
            if remote.Name:lower():find(pattern:lower()) then
                return remote
            end
        end
    end
    return nil
end

-- Função Kill Aura melhorada
local function KillAura()
    while toggles.killAura and LocalPlayer.Character and LocalPlayer.Character:FindFirstChild("HumanoidRootPart") do
        task.wait(0.1)
        local closestPlayer = nil
        local shortestDist = settings.killAuraRange
        
        for _, player in pairs(Players:GetPlayers()) do
            if player ~= LocalPlayer and player.Character and player.Character:FindFirstChild("Humanoid") and player.Character.Humanoid.Health > 0 then
                local hrp = player.Character:FindFirstChild("HumanoidRootPart")
                if hrp then
                    local dist = (LocalPlayer.Character.HumanoidRootPart.Position - hrp.Position).Magnitude
                    if dist < shortestDist then
                        shortestDist = dist
                        closestPlayer = player
                    end
                end
            end
        end
        
        if closestPlayer then
            -- Tentar diferentes métodos de ataque
            pcall(function()
                -- Método 1: ClickDetector
                local mouse = LocalPlayer:GetMouse()
                if mouse.Target then
                    local clickDetector = mouse.Target.Parent:FindFirstChildWhichIsA("ClickDetector")
                    if clickDetector then
                        clickDetector:Click()
                    end
                end
                
                -- Método 2: Equipar e usar ferramenta
                local tool = LocalPlayer.Character:FindFirstChildWhichIsA("Tool")
                if tool then
                    tool:Activate()
                end
                
                -- Método 3: RemoteEvent genérico
                local attackRemote = FindRemoteEvent("attack") or FindRemoteEvent("damage") or FindRemoteEvent("hit")
                if attackRemote then
                    attackRemote:FireServer(closestPlayer.Character)
                end
            end)
        end
    end
end

-- Função Auto Click
local function AutoClick()
    while toggles.autoClick do
        task.wait(settings.clickDelay)
        pcall(function()
            local tool = LocalPlayer.Character:FindFirstChildWhichIsA("Tool")
            if tool then
                tool:Activate()
            end
            
            -- Simular clique do mouse
            local VirtualInputManager = game:GetService("VirtualInputManager")
            VirtualInputManager:SendMouseButtonEvent(Vector2.new(500, 300), 0, true, Enum.UserInputType.MouseButton1, 0)
            task.wait(0.05)
            VirtualInputManager:SendMouseButtonEvent(Vector2.new(500, 300), 0, false, Enum.UserInputType.MouseButton1, 0)
        end)
    end
end

-- Função Auto Complete Task
local function AutoCompleteTask()
    while toggles.autoTask do
        task.wait(settings.autoTaskDelay)
        pcall(function()
            -- Procurar por prompts de proximidade
            for _, prompt in pairs(workspace:GetDescendants()) do
                if prompt:IsA("ProximityPrompt") then
                    local character = LocalPlayer.Character
                    if character and character:FindFirstChild("HumanoidRootPart") then
                        local distance = (character.HumanoidRootPart.Position - prompt.Parent.Position).Magnitude
                        if distance < 10 then
                            fireproximityprompt(prompt)
                        end
                    end
                end
                
                -- Procurar por ClickDetectors
                if prompt:IsA("ClickDetector") then
                    prompt:Click()
                end
                
                -- Procurar por partes com nome específico
                if prompt.Name:lower():find("task") or prompt.Name:lower():find("quest") or prompt.Name:lower():find("mission") then
                    if prompt:FindFirstChild("TouchInterest") then
                        LocalPlayer.Character.HumanoidRootPart.CFrame = prompt.CFrame
                    end
                end
            end
        end)
    end
end

-- Função Auto Collect
local function AutoCollect()
    while toggles.autoCollect do
        task.wait(0.3)
        pcall(function()
            for _, item in pairs(workspace:GetDescendants()) do
                if item:IsA("BasePart") and (item.Name:lower():find("coin") or item.Name:lower():find("item") or item.Name:lower():find("collect") or item.Name:lower():find("pickup")) then
                    local distance = (LocalPlayer.Character.HumanoidRootPart.Position - item.Position).Magnitude
                    if distance < 20 then
                        LocalPlayer.Character.HumanoidRootPart.CFrame = item.CFrame
                        task.wait(0.05)
                    end
                end
            end
        end)
    end
end

-- Função No Clip
local function SetNoClip(state)
    if not LocalPlayer.Character then return end
    
    for _, part in pairs(LocalPlayer.Character:GetDescendants()) do
        if part:IsA("BasePart") then
            part.CanCollide = not state
        end
    end
end

-- Função Fly
local flyConnection = nil
local flyBodyVelocity = nil

local function SetFly(state)
    if state then
        if flyConnection then flyConnection:Disconnect() end
        
        flyBodyVelocity = Instance.new("BodyVelocity")
        flyBodyVelocity.MaxForce = Vector3.new(100000, 100000, 100000)
        flyBodyVelocity.P = 10000
        flyBodyVelocity.Parent = LocalPlayer.Character.HumanoidRootPart
        
        flyConnection = RunService.RenderStepped:Connect(function()
            if not LocalPlayer.Character then return end
            
            local camera = workspace.CurrentCamera
            local moveDir = Vector3.new()
            local forward = camera.CFrame.LookVector
            local right = camera.CFrame.RightVector
            
            if UserInputService:IsKeyDown(Enum.KeyCode.W) then moveDir = moveDir + forward end
            if UserInputService:IsKeyDown(Enum.KeyCode.S) then moveDir = moveDir - forward end
            if UserInputService:IsKeyDown(Enum.KeyCode.D) then moveDir = moveDir + right end
            if UserInputService:IsKeyDown(Enum.KeyCode.A) then moveDir = moveDir - right end
            if UserInputService:IsKeyDown(Enum.KeyCode.Space) then moveDir = moveDir + Vector3.new(0, 1, 0) end
            if UserInputService:IsKeyDown(Enum.KeyCode.LeftControl) then moveDir = moveDir - Vector3.new(0, 1, 0) end
            
            flyBodyVelocity.Velocity = moveDir.Unit * settings.flySpeed
        end)
    else
        if flyConnection then flyConnection:Disconnect() end
        if flyBodyVelocity then flyBodyVelocity:Destroy() end
    end
end

-- Função Infinite Jump
local function SetInfiniteJump(state)
    if state then
        local humanoid = LocalPlayer.Character and LocalPlayer.Character:FindFirstChild("Humanoid")
        if humanoid then
            humanoid:SetStateEnabled(Enum.HumanoidStateType.Jumping, true)
        end
        
        local connection
        connection = UserInputService.JumpRequest:Connect(function()
            if toggles.infiniteJump and LocalPlayer.Character then
                local humanoid = LocalPlayer.Character:FindFirstChild("Humanoid")
                if humanoid then
                    humanoid:ChangeState(Enum.HumanoidStateType.Jumping)
                end
            end
        end)
    end
end

-- Função Infinite Stamina/Energy
local function SetInfiniteStamina(state)
    if state then
        RunService.Heartbeat:Connect(function()
            local humanoid = LocalPlayer.Character and LocalPlayer.Character:FindFirstChild("Humanoid")
            if humanoid then
                humanoid:SetAttribute("Stamina", 100)
                humanoid:SetAttribute("Energy", 100)
            end
        end)
    end
end

-- Função FullBright
local function SetFullBright(state)
    if state then
        lighting.Brightness = 2
        lighting.ClockTime = 14
        lighting.FogEnd = 100000
        lighting.GlobalShadows = false
        lighting.OutdoorAmbient = Color3.fromRGB(128, 128, 128)
        lighting.Ambient = Color3.fromRGB(128, 128, 128)
    else
        lighting.Brightness = 0.5
        lighting.ClockTime = 0
        lighting.FogEnd = 100
        lighting.GlobalShadows = true
        lighting.OutdoorAmbient = Color3.fromRGB(0, 0, 0)
        lighting.Ambient = Color3.fromRGB(0, 0, 0)
    end
end

-- Função Wallbang
local function SetWallbang(state)
    if state then
        local originalCanCollide = {}
        RunService.RenderStepped:Connect(function()
            if toggles.wallbang then
                for _, part in pairs(workspace:GetDescendants()) do
                    if part:IsA("BasePart") and part.Name ~= "Baseplate" then
                        if not originalCanCollide[part] then
                            originalCanCollide[part] = part.CanCollide
                        end
                        part.CanCollide = false
                    end
                end
            else
                for part, value in pairs(originalCanCollide) do
                    if part and part.Parent then
                        part.CanCollide = value
                    end
                end
            end
        end)
    end
end

