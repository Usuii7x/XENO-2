-- Auto Farm: Coleta Automática de Itens
local function StartAutoCollect()
    RunService:BindToRenderStep("AutoCollect", Enum.RenderPriority.Low.Value, function()
        if not Toggles.AutoCollectItems then
            RunService:UnbindFromRenderStep("AutoCollect")
            return
        end
        
        local playerChar = LocalPlayer.Character
        local rootPart = playerChar and playerChar:FindFirstChild("HumanoidRootPart")
        if not rootPart then return end
        
        for _, item in ipairs(Workspace:GetDescendants()) do
            if item:IsA("BasePart") and not item:IsA("Terrain") then
                for _, namePattern in ipairs(CollectableItems) do
                    if item.Name:find(namePattern) or string.find(item.Name, "Cap") then
                        local distance = (rootPart.Position - item.Position).Magnitude
                        if distance < 15 then
                            rootPart.CFrame = item.CFrame
                            wait(0.1)
                            fireproximityprompt(item)
                        end
                    end
                end
            end
        end
    end)
    Notify("Auto Collect", "🔄 Coleta automática ativada", 2)
end

-- Magnet System (arrasta itens para você)
local function StartMagnet()
    RunService:BindToRenderStep("Magnet", Enum.RenderPriority.Low.Value, function()
        if not Toggles.Magnet then
            RunService:UnbindFromRenderStep("Magnet")
            return
        end
        
        local playerChar = LocalPlayer.Character
        local rootPart = playerChar and playerChar:FindFirstChild("HumanoidRootPart")
        if not rootPart then return end
        
        for _, item in ipairs(Workspace:GetDescendants()) do
            if item:IsA("BasePart") and not item:IsA("Terrain") and item.Parent ~= playerChar then
                local distance = (rootPart.Position - item.Position).Magnitude
                if distance < Settings.MagnetRadius then
                    local direction = (rootPart.Position - item.Position).Unit
                    item.Velocity = direction * 50
                end
            end
        end
    end)
    Notify("Magnet", "🧲 Sistema de ímã ativado (Raio: " .. Settings.MagnetRadius .. ")", 2)
end

-- Auto Kill NPCs/Players
local function StartAutoKill()
    RunService:BindToRenderStep("AutoKill", Enum.RenderPriority.Low.Value, function()
        if not Toggles.AutoKill then
            RunService:UnbindFromRenderStep("AutoKill")
            return
        end
        
        local playerChar = LocalPlayer.Character
        local rootPart = playerChar and playerChar:FindFirstChild("HumanoidRootPart")
        local tool = playerChar and playerChar:FindFirstChildOfClass("Tool")
        if not rootPart or not tool then return end
        
        for _, npc in ipairs(Workspace:GetDescendants()) do
            if npc:IsA("Model") and npc:FindFirstChild("Humanoid") and npc ~= playerChar then
                local humanoid = npc.Humanoid
                local distance = (rootPart.Position - npc.PrimaryPart.Position).Magnitude
                if distance < Settings.AutoKillDistance and humanoid.Health > 0 then
                    local targetCFrame = npc.PrimaryPart.CFrame
                    rootPart.CFrame = targetCFrame + (targetCFrame.LookVector * 3)
                    wait(0.05)
                    tool:Activate()
                end
            end
        end
    end)
    Notify("Auto Kill", "🔪 Auto Kill ativado (Distância: " .. Settings.AutoKillDistance .. ")", 2)
end

