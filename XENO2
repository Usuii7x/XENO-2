-- Função para encontrar inimigos próximos
local function GetNearbyEnemies(range)
    local enemies = {}
    for _, v in pairs(Players:GetPlayers()) do
        if v ~= LocalPlayer and v.Character and v.Character:FindFirstChild("Humanoid") and v.Character.Humanoid.Health > 0 then
            if LocalPlayer.Character and LocalPlayer.Character:FindFirstChild("HumanoidRootPart") then
                local distance = (LocalPlayer.Character.HumanoidRootPart.Position - v.Character.HumanoidRootPart.Position).Magnitude
                if distance <= range then
                    table.insert(enemies, v)
                end
            end
        end
    end
    return enemies
end

-- Kill Aura
local function KillAuraFunction()
    while Config.KillAura and task.wait(0.1) do
        local enemies = GetNearbyEnemies(30)
        for _, enemy in ipairs(enemies) do
            if enemy.Character and enemy.Character:FindFirstChild("HumanoidRootPart") then
                local tool = LocalPlayer.Character and LocalPlayer.Character:FindFirstChildOfClass("Tool")
                if tool then
                    tool:Activate()
                    firetouchinterest(LocalPlayer.Character.HumanoidRootPart, enemy.Character.HumanoidRootPart, 0)
                    firetouchinterest(LocalPlayer.Character.HumanoidRootPart, enemy.Character.HumanoidRootPart, 1)
                end
            end
        end
    end
end

-- Anti AFK
local function AntiAFKFunction()
    while Config.AntiAFK and task.wait(60) do
        local vu = game:GetService("VirtualUser")
        vu:Button2Down(Vector2.new(0, 0), workspace.CurrentCamera.CFrame)
        task.wait(0.1)
        vu:Button2Up(Vector2.new(0, 0), workspace.CurrentCamera.CFrame)
    end
end

-- Destrancar portas
local function DestrancarPortasFunction()
    while Config.DestrancarPortas and task.wait(0.5) do
        for _, v in pairs(workspace:GetDescendants()) do
            if v:IsA("ProximityPrompt") or v:IsA("ClickDetector") then
                fireproximityprompt(v)
            end
            if v.Name:lower():match("door") or v.Name:lower():match("porta") then
                if v:IsA("BasePart") then
                    v.CanCollide = false
                    v.Transparency = 0.5
                end
            end
        end
    end
end

-- Auto comprar vantagens
local function AutoComprarFunction()
    while Config.AutoComprar and task.wait(1) do
        for _, v in pairs(LocalPlayer.PlayerGui:GetDescendants()) do
            if v:IsA("TextButton") and (v.Text:lower():match("comprar") or v.Text:lower():match("buy")) then
                v:Click()
            end
        end
        for _, v in pairs(workspace:GetDescendants()) do
            if v:IsA("ProximityPrompt") and v.Parent and v.Parent.Name:match("Vantagem") then
                fireproximityprompt(v)
            end
        end
    end
end

-- Auto upgrade armas
local function AutoUpgradeFunction()
    while Config.AutoUpgrade and task.wait(0.5) do
        for _, v in pairs(LocalPlayer.Backpack:GetChildren()) do
            if v:IsA("Tool") and v:FindFirstChild("UpgradeButton") then
                v.UpgradeButton:Click()
            end
        end
        for _, v in pairs(LocalPlayer.Character:GetChildren()) do
            if v:IsA("Tool") and v:FindFirstChild("UpgradeButton") then
                v.UpgradeButton:Click()
            end
        end
    end
end

-- Hit Kill
local function HitKillFunction()
    while Config.HitKill and task.wait(0.1) do
        local enemies = GetNearbyEnemies(50)
        for _, enemy in ipairs(enemies) do
            if enemy.Character and enemy.Character:FindFirstChild("Humanoid") then
                enemy.Character.Humanoid.Health = 0
            end
        end
    end
end

-- Congelar inimigos
local function CongelarInimigosFunction()
    while Config.CongelarInimigos and task.wait(0.5) do
        local enemies = GetNearbyEnemies(100)
        for _, enemy in ipairs(enemies) do
            if enemy.Character and enemy.Character:FindFirstChild("Humanoid") then
                enemy.Character.Humanoid.WalkSpeed = 0
                enemy.Character.Humanoid.JumpPower = 0
            end
        end
    end
end

-- Teleporte para local seguro
local function TeleportarSeguro()
    if LocalPlayer.Character and LocalPlayer.Character:FindFirstChild("HumanoidRootPart") then
        LocalPlayer.Character.HumanoidRootPart.CFrame = TPpos
        LocalPlayer.Character.Humanoid:ChangeState(Enum.HumanoidStateType.Jumping)
    end
end

