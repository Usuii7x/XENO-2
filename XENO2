                if isZombie or (not isPlayer and obj:FindFirstChild("Humanoid") and obj:GetAttribute("IsEnemy")) then
                    local root = obj:FindFirstChild("HumanoidRootPart") or obj:FindFirstChild("Torso")
                    if root then
                        local dist = (hrp.Position - root.Position).Magnitude
                        if dist < closestDist then
                            closestDist = dist
                            closestZombie = obj
                        end
                    end
                end
            end
