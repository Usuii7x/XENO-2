-- Função de munição infinita
local function SetupInfiniteAmmo()
    local playerGui = LocalPlayer:FindFirstChild("PlayerGui")
    if playerGui then
        local ammoGui = playerGui:FindFirstChild("Ammo")
        if ammoGui then
            local ammoText = ammoGui:FindFirstChild("TextLabel")
            if ammoText then
                ammoText:GetPropertyChangedSignal("Text"):Connect(function()
                    if Settings.InfiniteAmmo then
                        ammoText.Text = "∞"
                    end
                end)
                if Settings.InfiniteAmmo then
                    ammoText.Text = "∞"
                end
            end
        end
    end
end

-- Função para encontrar o melhor alvo
local function GetClosestPlayer()
    local closestDistance = Settings.FOVRadius
    local closestPlayer = nil
    local mousePos = UserInputService:GetMouseLocation()
    
    for _, player in pairs(Players:GetPlayers()) do
        if player ~= LocalPlayer and player.Character and player.Character:FindFirstChild("Humanoid") and player.Character.Humanoid.Health > 0 then
            local head = player.Character:FindFirstChild("Head")
            if head then
                local headPos, onScreen = workspace.CurrentCamera:WorldToScreenPoint(head.Position)
                if onScreen then
                    local distance = (Vector2.new(headPos.X, headPos.Y) - mousePos).Magnitude
                    if distance < closestDistance then
                        closestDistance = distance
                        closestPlayer = player
                    end
                end
            end
        end
    end
    
    return closestPlayer, closestDistance
end

-- Sistema de aimbot
local function UpdateAimbot()
    if not Settings.AimbotEnabled then
        if currentTarget then currentTarget = nil end
        return
    end
    
    local target, distance = GetClosestPlayer()
    if target and distance <= Settings.FOVRadius then
        currentTarget = target
        if target.Character and target.Character:FindFirstChild("Head") then
            local headPos = target.Character.Head.Position
            local camera = workspace.CurrentCamera
            
            -- Movimento suave
            local currentCFrame = camera.CFrame
            local lookAt = CFrame.new(camera.CFrame.Position, headPos)
            
            if Settings.Smoothness > 0 then
                local newCFrame = currentCFrame:Lerp(lookAt, Settings.Smoothness)
                camera.CFrame = newCFrame
            else
                camera.CFrame = lookAt
            end
        end
    else
        currentTarget = nil
    end
end

-- Detectar tecla para aimbot
UserInputService.InputBegan:Connect(function(input, gameProcessed)
    if gameProcessed then return end
    
    -- Abrir/fechar GUI com '[' e ']'
    if input.KeyCode == Enum.KeyCode.LeftBracket then
        local gui = game:GetService("CoreGui"):FindFirstChild("SniperArenaGUI")
        if gui then
            gui.Visible = not gui.Visible
        end
    end
    
    -- Ativar aimbot
    local shouldActivate = false
    
    if Settings.UseCustomKey and Settings.CustomKey then
        if input.KeyCode == Settings.CustomKey then
            shouldActivate = true
        end
    elseif input.UserInputType == Enum.UserInputType.MouseButton2 then
        shouldActivate = true
    end
    
    if shouldActivate then
        Settings.AimbotEnabled = true
        isAiming = true
    end
end)

UserInputService.InputEnded:Connect(function(input)
    if (Settings.UseCustomKey and input.KeyCode == Settings.CustomKey) or 
       (not Settings.UseCustomKey and input.UserInputType == Enum.UserInputType.MouseButton2) then
        Settings.AimbotEnabled = false
        isAiming = false
        currentTarget = nil
    end
end)

-- Atualizar aimbot constantemente
RunService.RenderStepped:Connect(function()
    if Settings.AimbotEnabled then
        UpdateAimbot()
    end
end)

