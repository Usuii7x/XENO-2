    for _, button in pairs(XenoLord.ScreenGui:GetDescendants()) do
        if button:IsA("TextButton") or button:IsA("TextLabel") then
            button.TextColor3 = cor.texto
        end
        if button:IsA("TextButton") then
            button.BackgroundColor3 = cor.fundo
            button.BorderColor3 = cor.destaque
        end
    end
    XenoLord.MainFrame.BackgroundColor3 = cor.fundo
    XenoLord.MainFrame.BorderColor3 = cor.destaque
end

