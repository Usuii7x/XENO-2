-- Loop do Infinite Ammo / No Reload (detecta ferramentas)
task.spawn(function()
    while task.wait(0.2) do
        if state.InfAmmo or state.NoReload then
            local tool = GetCurrentWeapon()
            if tool then
                if state.InfAmmo and tool:FindFirstChild("Ammo") then
                    tool.Ammo.Value = 9999
                end
                if state.NoReload and tool:FindFirstChild("Reloading") then
                    tool.Reloading.Value = false
                end
            end
        end
        if state.InfSprint and Player.Character and Player.Character:FindFirstChild("Humanoid") then
            Player.Character.Humanoid:SetStateEnabled(Enum.HumanoidStateType.Sprinting, true)
            Player.Character.Humanoid.Sprint = true
        end
    end
end)

