    self.MainFrame.Size = UDim2.new(0, 400, 0, 500)
    self.MainFrame.Position = UDim2.new(0.5, -200, 0.5, -250)
    self.MainFrame.BackgroundColor3 = Color3.fromRGB(20, 20, 30)
    self.MainFrame.BackgroundTransparency = 0.1
    self.MainFrame.BorderSizePixel = 0
    self.MainFrame.ClipsDescendants = true
    self.MainFrame.Parent = self.ScreenGui
    
    -- Título
    local title = Instance.new("TextLabel")
    title.Size = UDim2.new(1, 0, 0, 40)
    title.BackgroundColor3 = Color3.fromRGB(30, 30, 45)
    title.Text = "🔫 SNIPER ARENA - VULCAN UI"
    title.TextColor3 = Color3.fromRGB(0, 200, 255)
    title.Font = Enum.Font.GothamBold
    title.TextSize = 18
    title.Parent = self.MainFrame
    
    -- Abas
    local tabs = {"AIMBOT", "ESP", "MUNIÇÃO", "EXTRAS"}
    local tabButtons = {}
    local contentFrame = Instance.new("Frame")
    contentFrame.Size = UDim2.new(1, 0, 1, -40)
    contentFrame.Position = UDim2.new(0, 0, 0, 40)
    contentFrame.BackgroundTransparency = 1
    contentFrame.Parent = self.MainFrame
    
    for i, tabName in ipairs(tabs) do
        local btn = Instance.new("TextButton")
        btn.Size = UDim2.new(0.25, 0, 0, 30)
        btn.Position = UDim2.new((i-1) * 0.25, 0, 0, 40)
        btn.Text = tabName
        btn.BackgroundColor3 = Color3.fromRGB(40, 40, 55)
        btn.TextColor3 = Color3.fromRGB(200, 200, 200)
        btn.Font = Enum.Font.Gotham
        btn.TextSize = 14
        btn.Parent = self.MainFrame
        
        local tabContent = Instance.new("Frame")
        tabContent.Size = UDim2.new(1, 0, 1, 0)
        tabContent.BackgroundTransparency = 1
        tabContent.Visible = i == 1
        tabContent.Parent = contentFrame
        
        tabButtons[btn] = tabContent
        btn.MouseButton1Click:Connect(function()
            for _, content in pairs(tabButtons) do
                content.Visible = false
            end
            tabContent.Visible = true
        end)
        
        -- Conteúdo das abas
        if tabName == "AIMBOT" then
            self:CreateToggle(tabContent, "Ativar Aimbot", "Enabled", Settings.Aimbot, 10)
            self:CreateSlider(tabContent, "Smooth AIM", 0, 1, Settings.Aimbot.Smooth, function(v) Settings.Aimbot.Smooth = v end, 10, 50)
            self:CreateSlider(tabContent, "FOV (Ângulo)", 30, 180, Settings.Aimbot.FOV, function(v) Settings.Aimbot.FOV = v end, 10, 90)
            
            local priorityDrop = Instance.new("TextButton")
            priorityDrop.Size = UDim2.new(0.9, 0, 0, 35)
            priorityDrop.Position = UDim2.new(0.05, 0, 0, 130)
            priorityDrop.Text = "Prioridade: " .. Settings.Aimbot.Priority
            priorityDrop.BackgroundColor3 = Color3.fromRGB(45, 45, 60)
            priorityDrop.Parent = tabContent
            priorityDrop.MouseButton1Click:Connect(function()
                Settings.Aimbot.Priority = Settings.Aimbot.Priority == "Distance" and "Angle" or "Distance"
                priorityDrop.Text = "Prioridade: " .. Settings.Aimbot.Priority
            end)
            
            local partDrop = Instance.new("TextButton")
            partDrop.Size = UDim2.new(0.9, 0, 0, 35)
            partDrop.Position = UDim2.new(0.05, 0, 0, 175)
            partDrop.Text = "Alvo: " .. Settings.Aimbot.TargetPart
            partDrop.BackgroundColor3 = Color3.fromRGB(45, 45, 60)
            partDrop.Parent = tabContent
            partDrop.MouseButton1Click:Connect(function()
                local parts = {"Head", "Chest", "Random"}
                local current = table.find(parts, Settings.Aimbot.TargetPart)
                Settings.Aimbot.TargetPart = parts[current % #parts + 1]
                partDrop.Text = "Alvo: " .. Settings.Aimbot.TargetPart
            end)
            
        elseif tabName == "ESP" then
            self:CreateToggle(tabContent, "Ativar ESP", "Enabled", Settings.ESP, 10)
            self:CreateToggle(tabContent, "ESP Box", "Box", Settings.ESP, 50)
            self:CreateToggle(tabContent, "ESP Lines", "Lines", Settings.ESP, 90)
            self:CreateToggle(tabContent, "ESP Name", "Name", Settings.ESP, 130)
            self:CreateToggle(tabContent, "ESP Distance", "Distance", Settings.ESP, 170)
            self:CreateToggle(tabContent, "ESP Health Bar", "HealthBar", Settings.ESP, 210)
            self:CreateToggle(tabContent, "Cores por Time", "TeamColors", Settings.ESP, 250)
            
        elseif tabName == "MUNIÇÃO" then
            self:CreateToggle(tabContent, "Munição Infinita", "Enabled", Settings.InfiniteAmmo, 10)
            self:CreateToggle(tabContent, "Sem Recarregar", "NoReload", Settings.InfiniteAmmo, 50)
            
        elseif tabName == "EXTRAS" then
            self:CreateToggle(tabContent, "Sem Recoil", "NoRecoil", Settings, 10)
            self:CreateToggle(tabContent, "Sem Dispersão", "NoSpread", Settings, 50)
        end
    end
    
    -- Botão Fechar
    local closeBtn = Instance.new("TextButton")
    closeBtn.Size = UDim2.new(0, 30, 0, 30)
    closeBtn.Position = UDim2.new(1, -35, 0, 5)
    closeBtn.Text = "X"
    closeBtn.TextColor3 = Color3.fromRGB(255, 0, 0)
    closeBtn.BackgroundColor3 = Color3.fromRGB(40, 40, 55)
    closeBtn.Parent = self.MainFrame
    closeBtn.MouseButton1Click:Connect(function()
        self.ScreenGui.Enabled = not self.ScreenGui.Enabled
    end)
    
    -- Fechar com Insert
    UserInputService.InputBegan:Connect(function(input, gameProcessed)
        if not gameProcessed and input.KeyCode == Enum.KeyCode.Insert then
            self.ScreenGui.Enabled = not self.ScreenGui.Enabled
        end
    end)
end

function VulcanUI:CreateToggle(parent, labelText, settingName, settingsTable, yPos)
    local toggleBtn = Instance.new("TextButton")
    toggleBtn.Size = UDim2.new(0.9, 0, 0, 35)
    toggleBtn.Position = UDim2.new(0.05, 0, 0, yPos)
    toggleBtn.Text = labelText .. ": OFF"
    toggleBtn.BackgroundColor3 = Color3.fromRGB(45, 45, 60)
    toggleBtn.TextColor3 = Color3.fromRGB(200, 200, 200)
    toggleBtn.Parent = parent
    
    toggleBtn.MouseButton1Click:Connect(function()
        settingsTable[settingName] = not settingsTable[settingName]
        toggleBtn.Text = labelText .. ": " .. (settingsTable[settingName] and "ON" or "OFF")
        toggleBtn.BackgroundColor3 = settingsTable[settingName] and Color3.fromRGB(0, 100, 150) or Color3.fromRGB(45, 45, 60)
    end)
    
    return toggleBtn
end

function VulcanUI:CreateSlider(parent, labelText, minVal, maxVal, startVal, callback, yPos, offsetX)
    local sliderFrame = Instance.new("Frame")
    sliderFrame.Size = UDim2.new(0.9, 0, 0, 40)
    sliderFrame.Position = UDim2.new(0.05, 0, 0, yPos)
    sliderFrame.BackgroundTransparency = 1
    sliderFrame.Parent = parent
    
    local label = Instance.new("TextLabel")
    label.Size = UDim2.new(0.4, 0, 1, 0)
    label.Text = labelText .. ": " .. string.format("%.2f", startVal)
    label.TextColor3 = Color3.fromRGB(200, 200, 200)
    label.BackgroundTransparency = 1
    label.Parent = sliderFrame
    
    local slider = Instance.new("Frame")
    slider.Size = UDim2.new(0.5, 0, 0.3, 0)
    slider.Position = UDim2.new(0.45, 0, 0.35, 0)
    slider.BackgroundColor3 = Color3.fromRGB(60, 60, 80)
    slider.Parent = sliderFrame
    
    local fill = Instance.new("Frame")
    fill.Size = UDim2.new((startVal - minVal) / (maxVal - minVal), 0, 1, 0)
    fill.BackgroundColor3 = Color3.fromRGB(0, 150, 200)
    fill.Parent = slider
    
    local function updateSlider(input)
        local relativeX = math.clamp((input.Position.X - slider.AbsolutePosition.X) / slider.AbsoluteSize.X, 0, 1)
        local value = minVal + (maxVal - minVal) * relativeX
        fill.Size = UDim2.new(relativeX, 0, 1, 0)
        label.Text = labelText .. ": " .. string.format("%.2f", value)
        callback(value)
    end
    
    local dragging = false
    slider.InputBegan:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1 then
            dragging = true
            updateSlider(input)
        end
    end)
    
    UserInputService.InputEnded:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1 then
            dragging = false
        end
    end)
    
    UserInputService.InputChanged:Connect(function(input)
        if dragging and input.UserInputType == Enum.UserInputType.MouseMovement then
            updateSlider(input)
        end
    end)
end

-- // No Recoil & No Spread
local function HandleNoRecoilSpread()
    local tool = LocalPlayer.Character and LocalPlayer.Character:FindFirstChildOfClass("Tool")
    if tool then
        if Settings.NoRecoil then
            local recoilMod = tool:FindFirstChild("RecoilModifier")
            if recoilMod then recoilMod.Value = 0 end
        end
        if Settings.NoSpread then
            local spreadMod = tool:FindFirstChild("SpreadModifier")
            if spreadMod then spreadMod.Value = 0 end
        end
    end
end

-- // Inicialização
coroutine.wrap(function()
    while true do
        if Settings.Aimbot.Enabled then
            UpdateAimbot()
        end
        HandleInfiniteAmmo()
        HandleNoRecoilSpread()
        
        -- ESP Players
        if Settings.ESP.Enabled then
            for _, player in ipairs(Players:GetPlayers()) do
                if not ESPObjects[player] then
                    ESPObjects[player] = true
                    CreateESP(player)
                end
            end
        end
        
        AntiBan.Delay(0.01)
        RunService.RenderStepped:Wait()
    end
end)()

