-- Notificação customizada
local function Notify(Title, Content, Duration)
    Fluent:Notify({
        Title = Title,
        Content = Content,
        Duration = Duration or 3
    })
end

-- Função para obter a arma atual do jogador
local function GetCurrentWeapon()
    local char = Player.Character
    if not char then return nil end
    -- Em Michael's Zombies, as ferramentas geralmente ficam no Backpack ou Character
    local tool = char:FindFirstChildWhichIsA("Tool")
    if not tool and Player.Backpack then
        tool = Player.Backpack:FindFirstChildWhichIsA("Tool")
    end
    return tool
end

