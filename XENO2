-- ==================== HOTKEY MINIMIZAR ====================

local minimized = false
game:GetService("UserInputService").InputBegan:Connect(function(input, gp)
    if gp then return end
    if input.KeyCode == Enum.KeyCode.K then
        minimized = not minimized
        if minimized then
            Window:Minimize()
        else
            Window:Restore()
        end
    end
end)

