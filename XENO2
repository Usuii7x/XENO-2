-- =============================[ SISTEMA: ESP ]=============================
local ESPGui = nil
local ESPConnections = {}

local function CreateESP()
    if ESPGui then ESPGui:Destroy() end
    
    ESPGui = Instance.new("ScreenGui")
    ESPGui.Name = "PhantomESP"
    ESPGui.Parent = CoreGui
    ESPGui.ResetOnSpawn = false
    
    local function CreateESPElement(target, color, text, distance)
        local element = Instance.new("Frame")
        element.Name = "ESP_" .. target.Name
        element.Parent = ESPGui
        element.Size = UDim2.new(0, 2, 0, 2)
        element.BackgroundTransparency = 1
        
        local label = Instance.new("TextLabel")
        label.Parent = element
        label.Size = UDim2.new(0, 150, 0, 18)
        label.BackgroundTransparency = 1
        label.Font = Enum.Font.GothamBold
        label.Text = text .. (distance and " [" .. math.floor(distance) .. "m]" or "")
        label.TextColor3 = color
        label.TextSize = 11
        label.TextStrokeTransparency = 0.3
        label.TextStrokeColor3 = Color3.fromRGB(0, 0, 0)
        
        return element, label
    end
    
    -- Loop de renderização do ESP
    local renderConnection = RunService.RenderStepped:Connect(function()
        if not Settings.PlayerESP and not Settings.ZombieESP and not Settings.ItemESP then
            return
        end
        
        local character = Player.Character
        local rootPart = character and character:FindFirstChild("HumanoidRootPart")
        if not rootPart then return end
        
        -- Limpar ESPs antigos
        for _, child in ipairs(ESPGui:GetChildren()) do
            if child.Name:match("^ESP_") and not child.Persistent then
                child:Destroy()
            end
        end
        
        -- ESP para Players
        if Settings.PlayerESP then
            for _, otherPlayer in ipairs(Players:GetPlayers()) do
                if otherPlayer ~= Player and otherPlayer.Character then
                    local targetRoot = otherPlayer.Character:FindFirstChild("HumanoidRootPart")
                    if targetRoot then
                        local pos, onScreen = Camera:WorldToViewportPoint(targetRoot.Position)
                        local distance = (rootPart.Position - targetRoot.Position).Magnitude
                        
                        if onScreen and distance < 500 then
                            local existing = ESPGui:FindFirstChild("ESP_" .. otherPlayer.Name)
                            if not existing then
                                local teamColor = otherPlayer.Team and otherPlayer.Team.TeamColor and otherPlayer.Team.TeamColor.Color or Color3.fromRGB(255, 50, 50)
                                local element, label = CreateESPElement(otherPlayer, teamColor, otherPlayer.Name, distance)
                                element.Persistent = false
                            end
                            
                            local esp = ESPGui:FindFirstChild("ESP_" .. otherPlayer.Name)
                            if esp then
                                esp.Position = UDim2.new(0, pos.X - 75, 0, pos.Y - 25)
                                esp.Visible = true
                                if esp:FindFirstChildOfClass("TextLabel") then
                                    esp:FindFirstChildOfClass("TextLabel").Text = otherPlayer.Name .. " [" .. math.floor(distance) .. "m]"
                                end
                            end
                        end
                    end
                end
            end
        end
        
        -- ESP para Zombies
        if Settings.ZombieESP then
            for _, obj in ipairs(Workspace:GetDescendants()) do
                if obj:IsA("Model") and obj.Name:lower():match("zombie") and obj:FindFirstChild("HumanoidRootPart") then
                    local targetRoot = obj.HumanoidRootPart
                    local pos, onScreen = Camera:WorldToViewportPoint(targetRoot.Position)
                    local distance = (rootPart.Position - targetRoot.Position).Magnitude
                    
                    if onScreen and distance < 300 then
                        local existing = ESPGui:FindFirstChild("ESP_Zombie_" .. obj.Name)
                        if not existing then
                            local element, label = CreateESPElement(obj, Color3.fromRGB(50, 205, 50), "🧟 ZOMBIE", distance)
                            element.Name = "ESP_Zombie_" .. obj.Name
                        end
                        
                        local esp = ESPGui:FindFirstChild("ESP_Zombie_" .. obj.Name)
                        if esp then
                            esp.Position = UDim2.new(0, pos.X - 75, 0, pos.Y - 25)
                            esp.Visible = true
                        end
                    end
                end
            end
        end
    end)
    
    table.insert(ESPConnections, renderConnection)
end

