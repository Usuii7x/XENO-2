-- Funções de Utilidade
local function GetCarParts()
    local parts = {}
    for _, v in pairs(workspace:GetChildren()) do
        if v:IsA("Part") and v.Name:find("Car") then
            table.insert(parts, v)
        end
    end
    return parts
end

local function GetCarRarity(car)
    if not car then return "Common" end
    -- Lógica para detectar raridade do carro
    if car:FindFirstChild("Rarity") then
        local rarity = car.Rarity.Value
        if RaritySystem[rarity] then
            return rarity
        end
    end
    return "Common"
end

local function GetCarValue(car)
    if not car then return 0 end
    if car:FindFirstChild("Value") then
        return car.Value.Value
    end
    return 100
end

local function GetCarDamage(car)
    if not car then return 0 end
    if car:FindFirstChild("Damage") then
        return car.Damage.Value
    end
    return 0
end

-- Sistema de Teleporte
local function TeleportTo(position)
    if not position then return end
    local tweenInfo = TweenInfo.new(
        0.5,
        Enum.EasingStyle.Linear,
        Enum.EasingDirection.Out
    )
    local tween = TweenService:Create(RootPart, tweenInfo, {CFrame = CFrame.new(position)})
    tween:Play()
    tween.Completed:Wait()
end

-- Função Principal de Auto Farm
local function AutoFarmCar()
    if not Settings.AutoFarm then return end
    
    local carSpawns = {}
    for _, v in pairs(workspace:GetChildren()) do
        if v:IsA("Part") and v.Name:find("Spawn") then
            table.insert(carSpawns, v.Position)
        end
    end
    
    for _, spawnPos in ipairs(carSpawns) do
        if not Settings.AutoFarm then break end
        
        TeleportTo(spawnPos)
        wait(1)
        
        -- Interagir com o spawn
        local nearestCar = nil
        local nearestDist = math.huge
        
        for _, car in pairs(GetCarParts()) do
            local dist = (RootPart.Position - car.Position).Magnitude
            if dist < nearestDist and dist < 20 then
                nearestCar = car
                nearestDist = dist
            end
        end
        
        if nearestCar then
            local rarity = GetCarRarity(nearestCar)
            local carName = nearestCar.Name
            
            -- Verificar se o carro é o selecionado
            if Settings.SelectedCar ~= "All" and carName ~= Settings.SelectedCar then
                continue
            end
            
            -- Verificar raridade
            if Settings.SelectedRarity ~= "All" and rarity ~= Settings.SelectedRarity then
                continue
            end
            
            -- Comprar carro
            if nearestCar:FindFirstChild("BuyButton") then
                fireclickdetector(nearestCar.BuyButton)
                wait(1)
                
                -- Reparar se necessário
                if Settings.AutoRepair then
                    local damage = GetCarDamage(nearestCar)
                    if damage > Settings.RepairThreshold then
                        if nearestCar:FindFirstChild("RepairButton") then
                            fireclickdetector(nearestCar.RepairButton)
                            wait(1)
                        end
                    end
                end
                
                -- Vender carro
                if Settings.AutoSell then
                    local value = GetCarValue(nearestCar)
                    if value >= Settings.SellThreshold then
                        if nearestCar:FindFirstChild("SellButton") then
                            fireclickdetector(nearestCar.SellButton)
                            wait(1)
                        end
                    end
                end
            end
        end
        
        wait(2)
    end
end

-- Sistema de Coleta Automática
local function AutoCollectResources()
    while Settings.AutoCollect do
        -- Coletar dinheiro
        for _, v in pairs(workspace:GetChildren()) do
            if v:IsA("Part") and v.Name:find("Money") then
                TeleportTo(v.Position)
                wait(0.5)
                if v:FindFirstChild("Collect") then
                    fireclickdetector(v.Collect)
                end
            end
        end
        
        -- Coletar peças
        for _, v in pairs(workspace:GetChildren()) do
            if v:IsA("Part") and v.Name:find("Part") then
                TeleportTo(v.Position)
                wait(0.5)
                if v:FindFirstChild("Collect") then
                    fireclickdetector(v.Collect)
                end
            end
        end
        
        wait(Settings.CollectInterval)
    end
end

-- Loop Principal
local function MainLoop()
    while wait(1) do
        if Settings.AutoFarm then
            AutoFarmCar()
        end
    end
end

