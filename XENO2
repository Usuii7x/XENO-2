task.spawn(function()
    while task.wait(0.5) do
        if not state.AutoCollectPerks and not state.AutoCollectPoints then continue end
        
        local charPos = Player.Character and Player.Character:FindFirstChild("HumanoidRootPart")
        if not charPos then continue end
        
        for _, item in pairs(workspace:GetDescendants()) do
            if item:IsA("Model") or item:IsA("Part") then
                local isCollectible = false
                if state.AutoCollectPerks and (item.Name:find("Perk") or item.Name:find("PowerUp")) then
                    isCollectible = true
                end
                if state.AutoCollectPoints and (item.Name:find("Point") or item.Name:find("Essence") or item.Name:find("Cash")) then
                    isCollectible = true
                end
                
                if isCollectible and item:FindFirstChild("TouchInterest") then
                    local dist = (charPos.Position - item.Position).Magnitude
                    if dist < 15 then
                        -- Simula toque
                        firetouchinterest(charPos, item, 0)
                        task.wait(0.1)
                        firetouchinterest(charPos, item, 1)
                    end
                end
            end
        end
    end
end)

