-- Silent Aim (mira magnética sem mover tela)
CombatTab:CreateToggle({
    Name = "Silent Aim",
    CurrentValue = false,
    Flag = "SilentAim",
    Callback = function(Value)
        silentAimActive = Value
        if Value then
            game:GetService("RunService").RenderStepped:Connect(function()
                if not silentAimActive then return end
                local target = getClosestEnemy()
                if target and target.Character and target.Character:FindFirstChild("HumanoidRootPart") then
                    local hrp = target.Character.HumanoidRootPart
                    local direction = (hrp.Position - cam.CFrame.p).unit
                    local newCF = CFrame.new(cam.CFrame.p, cam.CFrame.p + direction)
                    cam.CFrame = newCF
                end
            end)
        end
    end
})

-- Aimbot (lock na cabeça)
