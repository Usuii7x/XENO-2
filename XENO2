-- Verificar se o jogo é Fix It Up (ajuste os nomes conforme necessário)
local function isFixItUpGame()
    return game:GetService("MarketplaceService"):GetProductInfo(game.PlaceId).Name:find("Fix It Up") or false
end

if not isFixItUpGame() then
    warn("Script pode não funcionar corretamente - lugar não reconhecido como Fix It Up")
end

-- Utilitários
local function findCar()
    -- Procura o carro mais próximo ou atual do jogador
    local character = player.Character
    if character then
        for _, v in pairs(workspace:GetDescendants()) do
            if v:IsA("Model") and v:FindFirstChild("Humanoid") and v:FindFirstChild("EnginePart") then
                return v
            end
        end
    end
    return nil
end

local function getCarParts(car)
    if not car then return {} end
    local parts = {}
    for _, partName in ipairs(pecas) do
        local part = car:FindFirstChild(partName)
        if part then table.insert(parts, part) end
    end
    return parts
end

local function repairCar(car)
    if not car then return end
    for _, part in pairs(getCarParts(car)) do
        if part:IsA("BasePart") and part:FindFirstChild("Damage") then
            part.Damage.Value = 0
        end
    end
    print("[Fix It Up] Carro reparado")
end

local function paintCar(car, color)
    if not car then return end
    for _, part in pairs(car:GetDescendants()) do
        if part:IsA("BasePart") and part.BrickColor then
            part.BrickColor = BrickColor.new(color)
        end
    end
    print("[Fix It Up] Carro pintado de " .. color)
end

local function upgradeCar(car)
    if not car then return end
    for _, upgrade in pairs({"EnginePower", "BrakeForce", "SuspensionHeight", "Transmission"}) do
        local upgradePart = car:FindFirstChild(upgrade)
        if upgradePart and upgradePart:IsA("NumberValue") then
            upgradePart.Value = upgradePart.Value + 0.1
        end
    end
    print("[Fix It Up] Carro melhorado")
end

local function sellCar(car)
    if not car then return end
    local sellButton = car:FindFirstChild("SellButton")
    if sellButton and sellButton:IsA("ClickDetector") then
        fireclickdetector(sellButton)
        print("[Fix It Up] Carro vendido")
    end
end

local function buyBestCar()
    local junkyard = workspace:FindFirstChild("Junkyard")
    if junkyard then
        local bestCar = nil
        local bestPrice = 0
        for _, car in pairs(junkyard:GetChildren()) do
            local price = car:FindFirstChild("Price")
            if price and price.Value > bestPrice then
                bestPrice = price.Value
                bestCar = car
            end
        end
        if bestCar then
            local buyButton = bestCar:FindFirstChild("BuyButton")
            if buyButton and buyButton:IsA("ClickDetector") then
                fireclickdetector(buyButton)
                print("[Fix It Up] Melhor carro comprado por " .. bestPrice)
            end
        end
    end
end

local function farmCycle()
    local car = findCar()
    if not car then
        buyBestCar()
        wait(1)
        car = findCar()
    end
    if car then
        repairCar(car)
        wait(0.5)
        if getgenv().FixItUpConfig.AutoPaint then
            paintCar(car, getgenv().FixItUpConfig.PaintColor)
            wait(0.5)
        end
        if getgenv().FixItUpConfig.AutoUpgrade then
            upgradeCar(car)
            wait(0.5)
        end
        sellCar(car)
    end
end

-- Anti-AFK
local function antiAFK()
    if not getgenv().FixItUpConfig.AntiAFK then return end
    local VirtualUser = game:GetService("VirtualUser")
    game:GetService("Players").LocalPlayer.Idled:Connect(function()
        VirtualUser:CaptureController()
        VirtualUser:ClickButton2(Vector2.new())
    end)
end

-- ESP (simples usando Highlight)
local espObjects = {}
local function toggleESP()
    if getgenv().FixItUpConfig.ESPEnabled then
        for _, obj in pairs(espObjects) do
            if obj and obj.Parent then obj:Destroy() end
        end
        table.clear(espObjects)
        
        for _, car in pairs(workspace:GetDescendants()) do
            if car:IsA("Model") and car:FindFirstChild("Humanoid") and car:FindFirstChild("EnginePart") then
                local highlight = Instance.new("Highlight")
                highlight.Parent = car
                highlight.Adornee = car
                highlight.FillColor = Color3.fromRGB(128, 0, 255)
                highlight.FillTransparency = 0.5
                highlight.OutlineColor = Color3.fromRGB(0, 0, 0)
                table.insert(espObjects, highlight)
            end
        end
    else
        for _, obj in pairs(espObjects) do
            if obj and obj.Parent then obj:Destroy() end
        end
        table.clear(espObjects)
    end
end

-- Teleportes simulados (ajustar conforme mapa real)
local function teleportToJunkyard()
    local junkyardSpot = workspace:FindFirstChild("JunkyardTeleport")
    if junkyardSpot then
        player.Character.HumanoidRootPart.CFrame = junkyardSpot.CFrame
    end
end

local function teleportToGarage()
    local garageSpot = workspace:FindFirstChild("GarageTeleport")
    if garageSpot then
        player.Character.HumanoidRootPart.CFrame = garageSpot.CFrame
    end
end

-- Loop principal de automação
spawn(function()
    while wait(1) do
        if getgenv().FixItUpConfig.AutoFarmMoney then
            farmCycle()
        elseif getgenv().FixItUpConfig.AutoRepair then
            local car = findCar()
            if car then repairCar(car) end
        end
        if getgenv().FixItUpConfig.AutoSell then
            local car = findCar()
            if car then sellCar(car) end
        end
        if getgenv().FixItUpConfig.AutoBuyBestCar then
            buyBestCar()
        end
        if getgenv().FixItUpConfig.TeleportCar then
            local car = findCar()
            if car then player.Character.HumanoidRootPart.CFrame = car.HumanoidRootPart.CFrame end
            getgenv().FixItUpConfig.TeleportCar = false
        end
        if getgenv().FixItUpConfig.TeleportJunkyard then
            teleportToJunkyard()
            getgenv().FixItUpConfig.TeleportJunkyard = false
        end
        if getgenv().FixItUpConfig.TeleportGarage then
            teleportToGarage()
            getgenv().FixItUpConfig.TeleportGarage = false
        end
        antiAFK()
        toggleESP()
    end
end)

-- Interface Fluent-style com Library padrão
local Window = {
    Visible = true,
    Toggle = function(self, text, callback)
        local btn = Instance.new("TextButton")
        btn.Size = UDim2.new(0, 200, 0, 40)
        btn.Text = text
        btn.BackgroundColor3 = Color3.fromRGB(30, 30, 50)
        btn.TextColor3 = Color3.fromRGB(200, 200, 255)
        btn.BorderSizePixel = 0
        btn.Parent = self.Container
        btn.MouseButton1Click:Connect(function()
            local newState = not (btn.BackgroundColor3 == Color3.fromRGB(80, 80, 150))
            btn.BackgroundColor3 = newState and Color3.fromRGB(80, 80, 150) or Color3.fromRGB(30, 30, 50)
            callback(newState)
        end)
        return btn
    end,
    Dropdown = function(self, text, items, callback)
        local dropdown = Instance.new("TextButton")
        dropdown.Size = UDim2.new(0, 200, 0, 40)
        dropdown.Text = text .. ": " .. items[1]
        dropdown.BackgroundColor3 = Color3.fromRGB(30, 30, 50)
        dropdown.TextColor3 = Color3.fromRGB(200, 200, 255)
        dropdown.Parent = self.Container
        local index = 1
        dropdown.MouseButton1Click:Connect(function()
            index = index % #items + 1
            dropdown.Text = text .. ": " .. items[index]
            callback(items[index])
        end)
    end,
    Button = function(self, text, callback)
        local btn = Instance.new("TextButton")
        btn.Size = UDim2.new(0, 200, 0, 40)
        btn.Text = text
        btn.BackgroundColor3 = Color3.fromRGB(50, 50, 100)
        btn.TextColor3 = Color3.fromRGB(255, 255, 255)
        btn.Parent = self.Container
        btn.MouseButton1Click:Connect(callback)
    end,
    Show = function(self)
        self.Frame.Visible = true
    end,
    Hide = function(self)
        self.Frame.Visible = false
    end
}

