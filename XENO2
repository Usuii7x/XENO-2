-- ====================== FUNÇÃO PRINCIPAL ======================
local function GetPromptsInRange(range)
    local prompts = {}
    for _, obj in ipairs(workspace:GetDescendants()) do
        if obj:IsA("ProximityPrompt") then
            local dist = (obj.Parent.Position - root.Position).Magnitude
            if dist < range then
                table.insert(prompts, {prompt = obj, distance = dist})
            end
        end
    end
    -- Ordena por distância (mais perto primeiro)
    table.sort(prompts, function(a,b) return a.distance < b.distance end)
    return prompts
end

-- ====================== AUTO FARM LOOP (Otimizado) ======================
spawn(function()
    while task.wait(0.4) do
        if not root then continue end

        local prompts = GetPromptsInRange(80)

        for _, data in ipairs(prompts) do
            local p = data.prompt
            local name = p.Name:lower()

            -- Auto Parts
            if getgenv().FarmConfig.AutoParts and (name:find("part") or name:find("peça") or name:find("scrap") or name:find("collect")) then
                fireproximityprompt(p)
                task.wait(0.3)

            -- Auto Repair
            elseif getgenv().FarmConfig.AutoRepair and (name:find("repair") or name:find("consertar") or name:find("fix")) then
                fireproximityprompt(p)
                task.wait(0.9)

            -- Auto Sell
            elseif getgenv().FarmConfig.AutoSell and (name:find("sell") or name:find("vender") or name:find("deliver") or name:find("entregar")) then
                fireproximityprompt(p)
                task.wait(1.2)

            -- Auto Buy
            elseif getgenv().FarmConfig.AutoBuy and (name:find("buy") or name:find("comprar") or name:find("purchase")) then
                fireproximityprompt(p)
                task.wait(1.8)

            -- Auto Money (15k+)
            elseif getgenv().FarmConfig.AutoMoney then
                local ls = player:FindFirstChild("leaderstats")
                local money = ls and (ls:FindFirstChild("Cash") or ls:FindFirstChild("Money") or ls:FindFirstChild("Dinheiro"))
                if money and money.Value >= 15000 and (name:find("money") or name:find("cash") or name:find("coletar")) then
                    fireproximityprompt(p)
                    task.wait(0.7)
                end
            end
        end
    end
end)

