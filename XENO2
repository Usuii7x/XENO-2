-- Lógica do Kill Aura e Auto Shoot (Loop Otimizado)
task.spawn(function()
    while task.wait(0.1) do
        if not state.KillAura and not state.AutoShoot then continue end
        
        local character = Player.Character
        local humanoidRootPart = character and character:FindFirstChild("HumanoidRootPart")
        if not humanoidRootPart then continue end
        
        -- Procura por zumbis (NPCs que são inimigos)
        local closestZombie = nil
        local closestDist = state.KillAuraRange
        
        for _, v in pairs(workspace:GetChildren()) do
            -- Detecção genérica de Zumbis: Pela tag Humanoid e nome/classe específica.
            -- Ajuste os nomes conforme o jogo: "Zombie", "ZombieNPC", etc.
            if v:IsA("Model") and v:FindFirstChild("Humanoid") and v.Humanoid.Health > 0 then
                local isEnemy = string.find(v.Name, "Zombie") or string.find(v.Name, "Zumbi") or string.find(v.ClassName, "Zombie")
                if isEnemy or not game:GetService("Players"):FindFirstChild(v.Name) then
                    local root = v:FindFirstChild("HumanoidRootPart") or v:FindFirstChild("Torso")
                    if root then
                        local dist = (humanoidRootPart.Position - root.Position).Magnitude
                        if dist < closestDist then
                            closestDist = dist
                            closestZombie = v
                        end
                    end
                end
            end
        end
        
        if closestZombie and closestDist <= state.KillAuraRange then
            -- Kill Aura: Equipa arma e ataca/mira
            if state.KillAura then
                local targetPart = closestZombie:FindFirstChild("Head")
                if state.HeadshotOnly and not targetPart then targetPart = closestZombie:FindFirstChild("HumanoidRootPart") end
                if not targetPart then targetPart = closestZombie:FindFirstChild("Torso") end
                
                if targetPart then
                    -- Mira na parte específica (caso o executor suporte, mantém a mira)
                    if state.AutoShoot then
                        -- Simula disparo
                        local tool = GetCurrentWeapon()
                        if tool and tool:FindFirstChild("RemoteEvent") then
                            tool:FindFirstChild("RemoteEvent"):FireServer(targetPart.Position)
                        elseif tool and tool:FindFirstChild("Handle") then
                            -- Fallback: clica automaticamente
                            local args = {targetPart, closestZombie.Humanoid}
                            game:GetService("ReplicatedStorage"):FindFirstChild("DamageEvent"):FireServer(unpack(args))
                        end
                    end
                    
                    -- Se for pra usar faca, equipa ela (Knife Mode)
                    if state.KillAuraKnife then
                        local knife = Player.Backpack:FindFirstChild("Knife") or character:FindFirstChild("Knife")
                        if knife then
                            Player.Character.Humanoid:EquipTool(knife)
                        end
                    end
                end
            end
        end
    end
end)

