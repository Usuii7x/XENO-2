-- Criar botões
local function CriarBotao(texto, yPos, configName)
    local btn = Instance.new("TextButton")
    btn.Size = UDim2.new(0, 180, 0, 40)
    btn.Position = UDim2.new(0, 20, 0, yPos)
    btn.Text = texto .. " ❌"
    btn.TextSize = 16
    btn.TextColor3 = Cores.Vermelho.texto
    btn.BackgroundColor3 = Cores.Vermelho.fundo
    btn.BorderColor3 = Cores.Vermelho.destaque
    btn.Parent = MainFrame
    
    btn.MouseButton1Click:Connect(function()
        Config[configName] = not Config[configName]
        btn.Text = texto .. (Config[configName] and " ✅" or " ❌")
        
        if configName == "KillAura" and Config.KillAura then
            task.spawn(KillAuraFunction)
        elseif configName == "AntiAFK" and Config.AntiAFK then
            task.spawn(AntiAFKFunction)
        elseif configName == "DestrancarPortas" and Config.DestrancarPortas then
            task.spawn(DestrancarPortasFunction)
        elseif configName == "AutoComprar" and Config.AutoComprar then
            task.spawn(AutoComprarFunction)
        elseif configName == "AutoUpgrade" and Config.AutoUpgrade then
            task.spawn(AutoUpgradeFunction)
        elseif configName == "HitKill" and Config.HitKill then
            task.spawn(HitKillFunction)
        elseif configName == "CongelarInimigos" and Config.CongelarInimigos then
            task.spawn(CongelarInimigosFunction)
        end
    end)
    
    return btn
end

