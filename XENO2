end

-- Sistema de munição infinita
local function SetupInfiniteAmmo()
    -- Procurar GUI de munição no jogo
    local function FindAndModifyAmmo()
        local playerGui = LocalPlayer:FindFirstChild("PlayerGui")
        if playerGui then
            -- Tentar encontrar diferentes estruturas de munição
            local possibleAmmoLocations = {
                playerGui:FindFirstChild("Ammo"),
                playerGui:FindFirstChild("WeaponGUI"),
                playerGui:FindFirstChild("HUD"),
                LocalPlayer.Character:FindFirstChild("Humanoid"),
                workspace.CurrentCamera:FindFirstChild("AmmoDisplay")
            }
            
            for _, location in pairs(possibleAmmoLocations) do
                if location then
                    local ammoText = location:FindFirstChildWhichIsA("TextLabel") or 
                                   location:FindFirstChildWhichIsA("TextBox") or
                                   location:FindFirstChild("Text")
                    
                    if ammoText then
                        if Settings.InfiniteAmmo then
                            ammoText.Text = "∞"
                            if ammoText:IsA("TextLabel") then
                                ammoText.TextColor3 = Color3.fromRGB(0, 255, 0)
                            end
                        end
                        
                        -- Monitorar mudanças
                        if not ammoText.Changed:IsConnected(ammoConnection) then
                            local conn
                            conn = ammoText:GetPropertyChangedSignal("Text"):Connect(function()
                                if Settings.InfiniteAmmo and ammoText.Text ~= "∞" then
                                    ammoText.Text = "∞"
                                end
                            end)
                        end
                    end
                end
            end
        end
    end
    
    FindAndModifyAmmo()
    
    -- Monitorar mudanças de personagem
    LocalPlayer.CharacterAdded:Connect(function()
        task.wait(0.5)
        FindAndModifyAmmo()
    end)
end

-- Verificar se o alvo é visível
local function IsVisible(targetPart)
    if not Settings.VisibleCheck then return true end
    
    local origin = workspace.CurrentCamera.CFrame.Position
    local direction = (targetPart.Position - origin).Unit
    local raycastParams = RaycastParams.new()
    raycastParams.FilterType = Enum.RaycastFilterType.Blacklist
    raycastParams.FilterDescendantsInstances = {LocalPlayer.Character}
    
    local raycastResult = workspace:Raycast(origin, direction * 1000, raycastParams)
    
    if raycastResult and raycastResult.Instance:IsDescendantOf(targetPart.Parent) then
        return true
    end
    return false
end

-- Encontrar o melhor alvo
local function GetClosestPlayer()
    local closestDistance = Settings.FOVRadius
    local closestPlayer = nil
    local mousePos = UserInputService:GetMouseLocation()
    
    for _, player in pairs(Players:GetPlayers()) do
        -- Verificar se não é o próprio jogador
        if player ~= LocalPlayer then
            -- Verificar time se necessário
            if Settings.TeamCheck and LocalPlayer.Team and player.Team == LocalPlayer.Team then
                continue
            end
            
            -- Verificar se o personagem existe e está vivo
            local character = player.Character
            if character and character:FindFirstChild("Humanoid") and character.Humanoid.Health > 0 then
                local aimPart = character:FindFirstChild(Settings.AimPart)
                if not aimPart then
                    aimPart = character:FindFirstChild("Head") or character:FindFirstChild("HumanoidRootPart")
                end
                
                if aimPart then
                    local aimPos, onScreen = workspace.CurrentCamera:WorldToScreenPoint(aimPart.Position)
                    
                    if onScreen then
                        -- Verificar visibilidade
                        if IsVisible(aimPart) then
                            local distance = (Vector2.new(aimPos.X, aimPos.Y) - mousePos).Magnitude
                            
                            if distance < closestDistance then
                                closestDistance = distance
                                closestPlayer = player
                            end
                        end
                    end
                end
            end
        end
    end
    
    return closestPlayer, closestDistance
end

-- Sistema de aimbot
local function UpdateAimbot()
    if not Settings.AimbotEnabled then
        if currentTarget then currentTarget = nil end
        return
    end
    
    local target, distance = GetClosestPlayer()
    
    if target and distance <= Settings.FOVRadius then
        currentTarget = target
        
        if target.Character then
            local aimPart = target.Character:FindFirstChild(Settings.AimPart)
            if not aimPart then
                aimPart = target.Character:FindFirstChild("Head") or target.Character:FindFirstChild("HumanoidRootPart")
            end
            
            if aimPart then
                local targetPos = aimPart.Position
                local camera = workspace.CurrentCamera
                
                -- Calcular nova posição da câmera
                local newCFrame = CFrame.new(camera.CFrame.Position, targetPos)
                
                -- Aplicar suavidade
                if Settings.Smoothness > 0 then
                    local currentCFrame = camera.CFrame
                    local lerpAlpha = math.min(1, Settings.Smoothness)
                    camera.CFrame = currentCFrame:Lerp(newCFrame, lerpAlpha)
                else
                    camera.CFrame = newCFrame
                end
            end
        end
    else
        currentTarget = nil
    end
end

