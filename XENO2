local AntiAFKTab = Window:CreateTab("🚫 Anti-AFK", "Clock")

-- Variáveis do Anti-AFK
local antiAfkActive = false
local movementActive = true
local mouseActive = true
local interval = 30
local mode = "Médio"
local notifications = false
local runningTasks = {}
local lastActionTime = 0

-- Configurações por modo
local modeSettings = {
    Leve = {
        movementChance = 0.3,
        mouseMovement = 2,
        variance = 0.2,
        keys = {"W", "A", "S", "D"}
    },
    Médio = {
        movementChance = 0.6,
        mouseMovement = 5,
        variance = 0.5,
        keys = {"W", "A", "S", "D"}
    },
    Agressivo = {
        movementChance = 0.9,
        mouseMovement = 10,
        variance = 0.8,
        keys = {"W", "A", "S", "D", "Space"}
    }
}

-- Função para randomizar intervalo
local function getRandomizedInterval()
    local variance = modeSettings[mode].variance
    local minTime = interval * (1 - variance)
    local maxTime = interval * (1 + variance)
    return math.random(minTime * 10, maxTime * 10) / 10
end

-- Função para simular tecla
local function simulateKeyPress(key)
    local VirtualUser = game:GetService("VirtualUser")
    
    if key == "Space" then
        pcall(function()
            game:GetService("Players").LocalPlayer.Character.Humanoid:ChangeState(Enum.HumanoidStateType.Jumping)
        end)
    else
        pcall(function()
            VirtualUser:CaptureController()
            VirtualUser:SetKeyDown(key)
            task.wait(0.1)
            VirtualUser:SetKeyUp(key)
        end)
    end
    
    if notifications then
        Rayfield:Notify({
            Title = "Anti-AFK",
            Content = "Tecla pressionada: " .. key,
            Duration = 2
        })
    end
end

-- Função para simular mouse
local function simulateMouseMovement()
    local mouse = game:GetService("Players").LocalPlayer:GetMouse()
    local movement = modeSettings[mode].mouseMovement
    local offsetX = math.random(-movement, movement)
    local offsetY = math.random(-movement, movement)
    
    pcall(function()
        mouse.Move(Vector2.new(mouse.X + offsetX, mouse.Y + offsetY))
        
        if notifications then
            Rayfield:Notify({
                Title = "Anti-AFK",
                Content = "Mouse movido",
                Duration = 2
            })
        end
    end)
end

-- Função para executar ação
local function performAction()
    if not antiAfkActive then return end
    
    local shouldMove = movementActive and math.random() <= modeSettings[mode].movementChance
    local shouldMouse = mouseActive and math.random() <= modeSettings[mode].movementChance
    
    if shouldMove then
        local keys = modeSettings[mode].keys
        local selectedKey = keys[math.random(#keys)]
        simulateKeyPress(selectedKey)
    end
    
    if shouldMouse then
        simulateMouseMovement()
    end
    
    if not shouldMove and not shouldMouse and movementActive then
        simulateKeyPress("W")
        task.wait(0.05)
        simulateKeyPress("S")
    end
end

-- Loop principal
local function antiAfkLoop()
    while antiAfkActive do
        local currentTime = tick()
        local timeSinceLast = currentTime - lastActionTime
        
        if timeSinceLast >= getRandomizedInterval() then
            performAction()
            lastActionTime = currentTime
        end
        
        task.wait(1)
    end
end

-- Funções de controle
local function startAntiAfk()
    if runningTasks.mainLoop then
        task.cancel(runningTasks.mainLoop)
    end
    
    runningTasks.mainLoop = task.spawn(antiAfkLoop)
    
    if notifications then
        Rayfield:Notify({
            Title = "Anti-AFK",
            Content = "Anti-AFK ativado!",
            Duration = 3
        })
    end
end

local function stopAntiAfk()
    if runningTasks.mainLoop then
        task.cancel(runningTasks.mainLoop)
        runningTasks.mainLoop = nil
    end
    
    if notifications then
        Rayfield:Notify({
            Title = "Anti-AFK",
            Content = "Anti-AFK desativado!",
            Duration = 3
        })
    end
end

