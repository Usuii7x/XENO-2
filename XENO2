--[[ FEATURE: ANTI-AFK ]]
local function toggleAntiAFK(state)
    if state then
        local VirtualInput = game:GetService("VirtualInputManager")
        local antiAFKConnection
        antiAFKConnection = RunService.RenderStepped:Connect(function()
            VirtualInput:SendKeyEvent(true, "W", false, game)
            task.wait(0.1)
            VirtualInput:SendKeyEvent(false, "W", false, game)
            task.wait(15)
        end)
        return antiAFKConnection
    end
    return nil
end

--[[ FEATURE: NO RECOIL / NO SPREAD ]]
local function toggleNoRecoil(state)
    if state then
        local mt = getrawmetatable(game)
        local oldIndex = mt.__index
        setreadonly(mt, false)
        mt.__index = newcclosure(function(self, key)
            if key == "Recoil" or key == "CameraRecoil" then
                return 0
            end
            if key == "Spread" then
                return 0
            end
            return oldIndex(self, key)
        end)
        setreadonly(mt, true)
    end
end

--[[ FEATURE: INFINITE AMMO ]]
local function toggleInfiniteAmmo(state)
    if state then
        local mt = getrawmetatable(game)
        local oldIndex = mt.__index
        setreadonly(mt, false)
        mt.__index = newcclosure(function(self, key)
            if key == "Ammo" then
                return 999
            end
            return oldIndex(self, key)
        end)
        setreadonly(mt, true)
    end
end

--[[ FEATURE: GOD MODE ]]
local function toggleGodMode(state)
    local character = Player.Character
    if not character then return end
    
    if state then
        local humanoid = character:FindFirstChild("Humanoid")
        if humanoid then
            humanoid.BreakJointsOnDeath = false
            humanoid:GetPropertyChangedSignal("Health"):Connect(function()
                if humanoid.Health <= 0 then
                    humanoid.Health = 100
                end
            end)
            humanoid.Health = 100
        end
    end
end

--[[ FEATURE: SPEED HACK ]]
function toggleSpeedHack(state)
    local character = Player.Character
    if not character then return end
    
    local humanoid = character:FindFirstChild("Humanoid")
    if humanoid then
        if state then
            humanoid.WalkSpeed = Settings.WalkSpeed
            humanoid.JumpPower = Settings.JumpPower
        else
            humanoid.WalkSpeed = PlayerState.OriginalWalkSpeed
            humanoid.JumpPower = PlayerState.OriginalJumpPower
        end
    end
end

--[[ FEATURE: NOCLIP ]]
function toggleNoclip(state)
    PlayerState.Noclipping = state
    
    if state then
        local noclipConnection
        noclipConnection = RunService.Stepped:Connect(function()
            local character = Player.Character
            if not character then return end
            
            for _, part in ipairs(character:GetDescendants()) do
                if part:IsA("BasePart") then
                    part.CanCollide = false
                end
            end
        end)
        return noclipConnection
    else
        local character = Player.Character
        if character then
            for _, part in ipairs(character:GetDescendants()) do
                if part:IsA("BasePart") then
                    part.CanCollide = true
                end
            end
        end
    end
    return nil
end

--[[ FEATURE: FLY ]]
local function toggleFly(state)
    local character = Player.Character
    if not character then return end
    
    local humanoid = character:FindFirstChild("Humanoid")
    if not humanoid then return end
    
    if state then
        PlayerState.Flying = true
        humanoid.PlatformStand = true
        
        local bodyVelocity = Instance.new("BodyVelocity")
        bodyVelocity.MaxForce = Vector3.new(10000, 10000, 10000)
        bodyVelocity.Velocity = Vector3.new(0, 0, 0)
        bodyVelocity.Parent = character:FindFirstChild("HumanoidRootPart") or character.PrimaryPart
        
        local bodyGyro = Instance.new("BodyGyro")
        bodyGyro.MaxTorque = Vector3.new(10000, 10000, 10000)
        bodyGyro.Parent = character:FindFirstChild("HumanoidRootPart") or character.PrimaryPart
        
        local flyConnection
        flyConnection = RunService.RenderStepped:Connect(function()
            if not PlayerState.Flying then
                flyConnection:Disconnect()
                bodyVelocity:Destroy()
                bodyGyro:Destroy()
                return
            end
            
            local moveDirection = Vector3.new(
                (UserInputService:IsKeyDown(Enum.KeyCode.D) and 1 or 0) - (UserInputService:IsKeyDown(Enum.KeyCode.A) and 1 or 0),
                (UserInputService:IsKeyDown(Enum.KeyCode.Space) and 1 or 0) - (UserInputService:IsKeyDown(Enum.KeyCode.LeftControl) and 1 or 0),
                (UserInputService:IsKeyDown(Enum.KeyCode.S) and 1 or 0) - (UserInputService:IsKeyDown(Enum.KeyCode.W) and 1 or 0)
            ).Unit
            
            local cameraLook = Camera.CFrame.LookVector
            local cameraRight = Camera.CFrame.RightVector
            local cameraUp = Camera.CFrame.UpVector
            
            local velocity = (cameraRight * moveDirection.X + cameraUp * moveDirection.Y + cameraLook * moveDirection.Z) * 50
            bodyVelocity.Velocity = velocity
            bodyGyro.CFrame = Camera.CFrame
        end)
    else
        PlayerState.Flying = false
        humanoid.PlatformStand = false
    end
end

--[[ FEATURE: INFINITE JUMP ]]
function toggleInfiniteJump(state)
    PlayerState.InfiniteJump = state
    
    if state then
        local infiniteJumpConnection
        infiniteJumpConnection = UserInputService.JumpRequest:Connect(function()
            local character = Player.Character
            local humanoid = character and character:FindFirstChild("Humanoid")
            if character and humanoid and humanoid:GetState() ~= Enum.HumanoidStateType.Jumping then
                humanoid:ChangeState(Enum.HumanoidStateType.Jumping)
            end
        end)
        return infiniteJumpConnection
    end
    return nil
end

--[[ FEATURE: INVISIBLE ]]
function toggleInvisible(state)
    local character = Player.Character
    if not character then return end
    
    for _, part in ipairs(character:GetChildren()) do
        if part:IsA("BasePart") then
            part.Transparency = state and 1 or 0
        elseif part:IsA("Accessory") then
            if part.Handle then
                part.Handle.Transparency = state and 1 or 0
            end
        end
    end
end

--[[ FEATURE: AUTO COLLECT ]]
local function startAutoCollect()
    if not Settings.AutoCollect then return end
    
    local collectionConnection
    collectionConnection = RunService.RenderStepped:Connect(function()
        local character = Player.Character
        if not character then return end
        
        local rootPart = character:FindFirstChild("HumanoidRootPart")
        if not rootPart then return end
        
        for _, item in ipairs(Workspace:GetDescendants()) do
            if item:IsA("BasePart") and item.Name:match("Loot") or item:IsA("Tool") then
                local distance = (rootPart.Position - item.Position).Magnitude
                if distance <= Settings.AutoCollectRadius then
                    -- Tentar coletar o item
                    fireclickdetector(item:FindFirstChild("ClickDetector") or item.Parent:FindFirstChild("ClickDetector"))
                end
            end
        end
    end)
    return collectionConnection
end

--[[ FEATURE: REMOVE FOG ]]
local function toggleRemoveFog(state)
    if state then
        Lighting.FogEnd = 100000
        Lighting.FogStart = 100000
        Lighting.Atmosphere:Destroy()
    else
        -- Resetar fog
        Lighting.FogEnd = 1000
        Lighting.FogStart = 0
    end
end

--[[ FEATURE: FULLBRIGHT ]]
local function toggleFullbright(state)
    if state then
        Lighting.Brightness = 2
        Lighting.ClockTime = 12
        Lighting.OutdoorAmbient = Color3.fromRGB(128, 128, 128)
        Lighting.Ambient = Color3.fromRGB(128, 128, 128)
        Lighting.GlobalShadows = false
    else
        Lighting.Brightness = 1
        Lighting.OutdoorAmbient = Color3.fromRGB(0, 0, 0)
        Lighting.Ambient = Color3.fromRGB(0, 0, 0)
        Lighting.GlobalShadows = true
    end
end

--[[ FEATURE: FPS BOOSTER ]]
local function toggleFPSBooster(state)
    if state then
        -- Desabilitar efeitos visuais pesados
        settings().Rendering.QualityLevel = 1
        Workspace.DescendantAdded:Connect(function(descendant)
            if descendant:IsA("ParticleEmitter") or descendant:IsA("Smoke") or descendant:IsA("Fire") then
                descendant.Enabled = false
            end
        end)
        Lighting.Bloom.Enabled = false
        Lighting.ColorCorrection.Enabled = false
        Lighting.SunRays.Enabled = false
    else
        settings().Rendering.QualityLevel = 10
        Lighting.Bloom.Enabled = true
        Lighting.ColorCorrection.Enabled = true
        Lighting.SunRays.Enabled = true
    end
end

--[[ FEATURE: REMOVE ZOMBIES ]]
local function removeZombies()
    for _, zombie in ipairs(Workspace:GetDescendants()) do
        if zombie.Name:lower():match("zombie") or zombie:IsA("Model") and zombie:FindFirstChild("Humanoid") and zombie.Name:lower():match("zombie") then
            zombie:Destroy()
        end
    end
end

--[[ ESP SYSTEM ]]
local function createESP()
    -- Sistema básico de ESP usando caixas de texto
    local ESPGui = Instance.new("ScreenGui")
    ESPGui.Name = "PhantomESP"
    ESPGui.Parent = game:GetService("CoreGui")
    ESPGui.ResetOnSpawn = false
    
    local function addESP(target, color, name, distance)
        local espHolder = Instance.new("Frame")
        espHolder.Name = "ESP_" .. target.Name
        espHolder.Parent = ESPGui
        espHolder.Size = UDim2.new(0, 2, 0, 2)
        espHolder.BackgroundTransparency = 1
        
        local nameLabel = Instance.new("TextLabel")
        nameLabel.Parent = espHolder
        nameLabel.Size = UDim2.new(0, 100, 0, 16)
        nameLabel.BackgroundTransparency = 1
        nameLabel.Font = Enum.Font.GothamBold
        nameLabel.Text = name .. (distance and " (" .. math.floor(distance) .. "m)" or "")
        nameLabel.TextColor3 = color
        nameLabel.TextSize = 11
        nameLabel.TextStrokeTransparency = 0.5
        nameLabel.TextStrokeColor3 = Color3.fromRGB(0, 0, 0)
        
        return espHolder
    end
    
    -- Atualizar posições dos ESPs
    RunService.RenderStepped:Connect(function()
        if not Settings.PlayerESP then
            for _, esp in ipairs(ESPGui:GetChildren()) do
                esp:Destroy()
            end
            return
        end
        
        for _, otherPlayer in ipairs(Players:GetPlayers()) do
            if otherPlayer ~= Player and otherPlayer.Character and otherPlayer.Character:FindFirstChild("HumanoidRootPart") then
                local pos, onScreen = Camera:WorldToViewportPoint(otherPlayer.Character.HumanoidRootPart.Position)
                local esp = ESPGui:FindFirstChild("ESP_" .. otherPlayer.Name)
                local distance = (Player.Character and Player.Character:FindFirstChild("HumanoidRootPart") and (Player.Character.HumanoidRootPart.Position - otherPlayer.Character.HumanoidRootPart.Position).Magnitude or 0)
                
                if onScreen then
                    if not esp then
                        local teamColor = otherPlayer.TeamColor and otherPlayer.TeamColor.Color or Color3.fromRGB(255, 255, 255)
                        esp = addESP(otherPlayer, teamColor, otherPlayer.Name, distance)
                    end
                    esp.Position = UDim2.new(0, pos.X - 50, 0, pos.Y - 20)
                    esp.Visible = true
                    
                    if esp:FindFirstChild("NameLabel") then
                        esp.NameLabel.Text = otherPlayer.Name .. " (" .. math.floor(distance) .. "m)"
                    end
                else
                    if esp then
                        esp.Visible = false
                    end
                end
            end
        end
    end)
end

