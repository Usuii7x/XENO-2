local aimbotSmoothness = 0.3

-- ============================================
-- FUNÇÕES DE UTILIDADE
-- ============================================
local function GetZombies()
    local zombies = {}
    for _, v in ipairs(workspace:GetChildren()) do
        if v:FindFirstChild("Humanoid") and v:FindFirstChild("Head") then
            if v.Name:lower():find("zombie") or v:FindFirstChild("Zombie") then
                table.insert(zombies, v)
            end
        end
    end
    return zombies
end

local function GetItems()
    local items = {}
    for _, v in ipairs(workspace:GetChildren()) do
        if v:IsA("Model") and (v:FindFirstChild("Handle") or v:FindFirstChild("Part")) then
            if v.Name:lower():find("ammo") or v.Name:lower():find("weapon") or v.Name:lower():find("med") then
                table.insert(items, v)
            end
        end
    end
    return items
end

local function GetNearestZombie()
    local character = LocalPlayer.Character
    if not character or not character:FindFirstChild("HumanoidRootPart") then return nil end
    
    local rootPart = character.HumanoidRootPart
    local nearest = nil
    local shortestDistance = aimbotFOV
    
    for _, zombie in ipairs(GetZombies()) do
        if zombie and zombie:FindFirstChild("Head") and zombie:FindFirstChild("Humanoid") and zombie.Humanoid.Health > 0 then
            local headPos = Camera:WorldToViewportPoint(zombie.Head.Position)
            local screenDistance = (Vector2.new(headPos.X, headPos.Y) - UserInputService:GetMouseLocation()).magnitude
            
            if screenDistance < shortestDistance then
                shortestDistance = screenDistance
                nearest = zombie
            end
        end
    end
    
    return nearest
end

-- ============================================
-- SISTEMA DE ESP
-- ============================================
local function CreateESP(instance, color, name)
    if not instance or not instance:FindFirstChild("HumanoidRootPart") then return nil end
    
    -- Highlight para contorno
    local highlight = Instance.new("Highlight")
    highlight.Name = "ESP_Highlight"
    highlight.FillColor = color
    highlight.FillTransparency = 0.6
    highlight.OutlineColor = color
    highlight.OutlineTransparency = 0.2
    highlight.DepthMode = Enum.HighlightDepthMode.AlwaysOnTop
    highlight.Adornee = instance
    highlight.Parent = instance
    
    -- BillboardGui para nome
    local billboard = Instance.new("BillboardGui")
    billboard.Name = "ESP_Name"
    billboard.Size = UDim2.new(0, 200, 0, 50)
    billboard.StudsOffset = Vector3.new(0, 2.5, 0)
    billboard.AlwaysOnTop = true
    billboard.Parent = instance
    
    local textLabel = Instance.new("TextLabel")
    textLabel.Size = UDim2.new(1, 0, 1, 0)
    textLabel.BackgroundTransparency = 1
    textLabel.Text = name
    textLabel.TextColor3 = color
    textLabel.TextStrokeTransparency = 0
    textLabel.TextStrokeColor3 = Color3.new(0, 0, 0)
    textLabel.TextScaled = true
    textLabel.Font = Enum.Font.GothomBold
    textLabel.Parent = billboard
    
    return {highlight = highlight, billboard = billboard}
end

local function RemoveESP(instance)
    if instance and instance:FindFirstChild("ESP_Highlight") then
        instance.ESP_Highlight:Destroy()
    end
    if instance and instance:FindFirstChild("ESP_Name") then
        instance.ESP_Name:Destroy()
    end
end

local function UpdateESP()
    if not ESPEnabled then
        for _, obj in pairs(espObjects) do
            RemoveESP(obj)
        end
        espObjects = {}
        return
    end
    
    -- ESP para Zombies
    for _, zombie in ipairs(GetZombies()) do
        if not espObjects[zombie] then
            local distance = (LocalPlayer.Character and LocalPlayer.Character:FindFirstChild("HumanoidRootPart") and 
                             (zombie:FindFirstChild("HumanoidRootPart") and (LocalPlayer.Character.HumanoidRootPart.Position - zombie.HumanoidRootPart.Position).magnitude or 999)) or 999
            local health = zombie:FindFirstChild("Humanoid") and math.floor(zombie.Humanoid.Health) or 0
            espObjects[zombie] = CreateESP(zombie, ZombieESPColor, "🧟 " .. zombie.Name .. " | " .. health .. "❤️ | " .. math.floor(distance) .. "m")
        end
    end
    
    -- ESP para Itens
    if ShowTeam then
        for _, item in ipairs(GetItems()) do
            if not espObjects[item] then
                espObjects[item] = CreateESP(item, ItemESPColor, "📦 " .. item.Name)
            end
        end
    end
end

-- Loop do ESP
RunService.RenderStepped:Connect(function()
    if ESPEnabled then
        UpdateESP()
    end
end)

-- ============================================
-- SISTEMA DE AIMBOT
-- ============================================
local function AimAt(position)
    if not AimbotEnabled then return end
    
    local tweenInfo = TweenInfo.new(aimbotSmoothness, Enum.EasingStyle.Sine, Enum.EasingDirection.Out)
    local tween = TweenService:Create(Camera, tweenInfo, {CFrame = CFrame.new(Camera.CFrame.Position, position)})
    tween:Play()
end

local function SilentAim(targetPosition)
    if not SilentAimEnabled then return end
    
    -- Calcula o ângulo de visualização para o alvo
    local cameraCF = Camera.CFrame
    local direction = (targetPosition - cameraCF.Position).unit
    local newCF = CFrame.new(cameraCF.Position, cameraCF.Position + direction)
    
    -- Aplica silenciosamente (invisível para outros jogadores)
    Camera.CFrame = newCF
end

-- Aimbot automático
RunService.RenderStepped:Connect(function()
    if not AimbotEnabled then return end
    
    local nearestZombie = GetNearestZombie()
    if nearestZombie and nearestZombie:FindFirstChild("Head") then
        local headPos = nearestZombie.Head.Position
        if SilentAimEnabled then
            SilentAim(headPos)
        else
            AimAt(headPos)
        end
    end
end)

-- ============================================
-- SISTEMA DE AUTO FARM
-- ============================================
local function AutoFarm()
    while AutoFarmEnabled and RunService.RenderStepped do
        local nearestZombie = GetNearestZombie()
        if nearestZombie and nearestZombie:FindFirstChild("HumanoidRootPart") then
            local character = LocalPlayer.Character
            if character and character:FindFirstChild("HumanoidRootPart") then
                -- Movimento automático em direção ao zumbi
                local hrp = character.HumanoidRootPart
                local zombiePos = nearestZombie.HumanoidRootPart.Position
                local direction = (zombiePos - hrp.Position).unit
                local newPos = hrp.Position + direction * 16
                
                hrp.CFrame = CFrame.new(newPos, zombiePos)
                
                -- Disparo automático (simula clique do mouse)
                local args = {
                    [1] = nearestZombie:FindFirstChild("Head") or nearestZombie:FindFirstChild("HumanoidRootPart")
                }
                game:GetService("ReplicatedStorage"):FindFirstChild("Damage") and 
                game:GetService("ReplicatedStorage").Damage:FireServer(unpack(args))
            end
        end
        wait(0.1)
    end
end

-- ============================================
-- RECURSOS DE JOGABILIDADE
-- ============================================
local function InfiniteAmmo()
    local backpack = LocalPlayer.Backpack
    local character = LocalPlayer.Character
    
    for _, tool in ipairs(backpack:GetChildren()) do
        if tool:IsA("Tool") and tool:FindFirstChild("Ammo") then
            tool.Ammo.Value = 999
        end
    end
    
    if character then
        for _, tool in ipairs(character:GetChildren()) do
            if tool:IsA("Tool") and tool:FindFirstChild("Ammo") then
                tool.Ammo.Value = 999
            end
        end
    end
end

local function NoRecoil()
    local character = LocalPlayer.Character
    if character then
        for _, tool in ipairs(character:GetChildren()) do
            if tool:IsA("Tool") and tool:FindFirstChild("Recoil") then
                tool.Recoil.Value = 0
            end
        end
    end
end

local function SpeedHack(speed)
    local character = LocalPlayer.Character
    if character and character:FindFirstChild("Humanoid") then
        character.Humanoid.WalkSpeed = speed
    end
end

local function JumpPower(power)
    local character = LocalPlayer.Character
    if character and character:FindFirstChild("Humanoid") then
        character.Humanoid.JumpPower = power
    end
end

-- Loops para recursos contínuos
game:GetService("LoopRun").RenderStepped:Connect(function()
    if InfiniteAmmo then
        InfiniteAmmo()
    end
    if NoRecoil then
        NoRecoil()
    end
end)

