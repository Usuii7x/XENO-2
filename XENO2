-- ==================== AIMBOT ====================
local function getClosest()
    local closest, dist = nil, fov
    local mousePos = UserInput:GetMouseLocation()
    
    for _, p in ipairs(Players:GetPlayers()) do
        if p ~= player and p.Character and p.Character:FindFirstChild("Head") then
            local humanoid = p.Character:FindFirstChild("Humanoid")
            if humanoid and humanoid.Health > 0 then
                local head = p.Character.Head
                local screen, onScreen = Camera:WorldToViewportPoint(head.Position)
                
                if onScreen then
                    local distance = (Vector2.new(screen.X, screen.Y) - mousePos).Magnitude
                    if distance < dist then
                        dist = distance
                        closest = head
                    end
                end
            end
        end
    end
    return closest
end

local function startAimbot()
    if connection then return end
    connection = RunService.RenderStepped:Connect(function()
        if not aimbotEnabled then return end
        
        local holding = (aimKey.EnumType == Enum.UserInputType and UserInput:IsMouseButtonPressed(aimKey)) or
                        (aimKey.EnumType == Enum.KeyCode and UserInput:IsKeyDown(aimKey))
        
        if not holding then return end
        
        local target = getClosest()
        if target then
            local targetPos = Camera:WorldToScreenPoint(target.Position + Vector3.new(0, 0.1, 0))
            local mouse = UserInput:GetMouseLocation()
            
            local x = (targetPos.X - mouse.X) / smoothness
            local y = (targetPos.Y - mouse.Y) / smoothness
            
            mousemoverel(x, y)
        end
    end)
end

Combat:CreateToggle({
