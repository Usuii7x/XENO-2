-- ESP (Player, Car, Items)
local espObjects = {}
local function CreateESP(part, color)
    local highlight = Instance.new("Highlight")
    highlight.Parent = part
    highlight.FillColor = color
    highlight.FillTransparency = 0.5
    highlight.OutlineColor = Color3.new(1,1,1)
    highlight.OutlineTransparency = 0
    table.insert(espObjects, highlight)
end

local function StartESP()
    RunService:BindToRenderStep("ESP", Enum.RenderPriority.Low.Value, function()
        if not Toggles.ESP then
            for _, esp in ipairs(espObjects) do
                esp:Destroy()
            end
            espObjects = {}
            RunService:UnbindFromRenderStep("ESP")
            return
        end
        
        -- ESP Players
        for _, player in ipairs(Players:GetPlayers()) do
            if player ~= LocalPlayer then
                local char = player.Character
                if char and char:FindFirstChild("HumanoidRootPart") then
                    CreateESP(char.HumanoidRootPart, Color3.new(1,0,0)) -- Vermelho para players
                end
            end
        end
        
        -- ESP Cars
        for _, vehicle in ipairs(Workspace:GetDescendants()) do
            if vehicle:IsA("Model") and vehicle:FindFirstChild("VehicleSeat") then
                local primary = vehicle.PrimaryPart
                if primary then
                    CreateESP(primary, Color3.new(0,1,0)) -- Verde para carros
                end
            end
        end
        
        -- ESP Items
        for _, item in ipairs(Workspace:GetDescendants()) do
            if item:IsA("BasePart") and not item:IsA("Terrain") then
                for _, pattern in ipairs(CollectableItems) do
                    if item.Name:find(pattern) then
                        CreateESP(item, Color3.new(0,0,1)) -- Azul para itens
                    end
                end
            end
        end
        
        wait(0.5)
    end)
    Notify("ESP", "👁️ ESP ativado", 2)
end

-- Teleport to Player
local function TeleportToPlayer(PlayerName)
    for _, player in ipairs(Players:GetPlayers()) do
        if player.Name == PlayerName then
            local char = player.Character
            local rootPart = char and char:FindFirstChild("HumanoidRootPart")
            if rootPart and LocalPlayer.Character then
                LocalPlayer.Character:SetPrimaryPartCFrame(rootPart.CFrame + Vector3.new(0, 3, 0))
                Notify("Teleport", "✨ Teleportado para " .. player.Name, 2)
            end
            return
        end
    end
    Notify("Erro", "❌ Jogador não encontrado", 1.5)
end

-- Remove Fog
local function RemoveFog()
    Lighting.FogEnd = Enabled and 100000 or 1000
    Lighting.FogStart = Enabled and 100000 or 0
    Lighting.Atmosphere:Destroy()
end

-- FPS Booster (remove decorações)
local function FPSBooster()
    Workspace.Decorations:ClearAllChildren()
    Workspace.Terrain.WaterWaveSize = 0
    Workspace.Terrain.WaterReflectance = 0
    Workspace.Terrain.WaterTransparency = 1
    for _, part in ipairs(Workspace:GetDescendants()) do
        if part:IsA("ParticleEmitter") or part:IsA("Smoke") or part:IsA("Fire") then
            part.Enabled = false
        end
    end
end

