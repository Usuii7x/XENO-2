-- Variáveis globais para toggles
local fullbrightEnabled = false
local killAuraEnabled = false
local autoCompleteEnabled = false
local infiniteStaminaEnabled = false
local infiniteAmmoEnabled = false
local espEnabled = false
local noclipEnabled = false
local speedEnabled = false
local jumpEnabled = false

local player = game.Players.LocalPlayer
local character = player.Character or player.CharacterAdded:Wait()
local humanoid = character:WaitForChild("Humanoid")

-- Atualiza character
player.CharacterAdded:Connect(function(newChar)
    character = newChar
    humanoid = newChar:WaitForChild("Humanoid")
end)

-- ==================== FUNÇÕES ====================

-- Fullbright
local function toggleFullbright(state)
    fullbrightEnabled = state
    if state then
        game:GetService("Lighting").Brightness = 2
        game:GetService("Lighting").ClockTime = 14
        game:GetService("Lighting").FogEnd = 100000
        game:GetService("Lighting").GlobalShadows = false
        game:GetService("Lighting").Ambient = Color3.fromRGB(255,255,255)
    else
        game:GetService("Lighting").Brightness = 1
        game:GetService("Lighting").ClockTime = 12
        game:GetService("Lighting").GlobalShadows = true
    end
end

-- Kill Aura
local function startKillAura()
    spawn(function()
        while killAuraEnabled do
            wait(0.1)
            if not character or not character:FindFirstChild("HumanoidRootPart") then continue end
            local root = character.HumanoidRootPart
            for _, v in pairs(workspace:GetDescendants()) do
                if v.Name:lower():find("enemy") or v.Name:lower():find("zombie") or v.Name:lower():find("hostile") or 
                   (v:FindFirstChild("Humanoid") and v ~= character and v.Humanoid.Health > 0) then
                    local dist = (v.HumanoidRootPart.Position - root.Position).Magnitude
                    if dist < 20 then
                        v.Humanoid.Health = 0
                        -- Tenta dar dano via FireServer se existir remote
                    end
                end
            end
        end
    end)
end

-- Infinite Stamina
local function infiniteStamina(state)
    infiniteStaminaEnabled = state
    spawn(function()
        while infiniteStaminaEnabled do
            wait(0.5)
            if humanoid then
                humanoid:SetAttribute("Stamina", 100) -- Ajuste conforme o nome do atributo no jogo
                -- Alternativa comum:
                if humanoid:FindFirstChild("Stamina") then
                    humanoid.Stamina.Value = 100
                end
            end
        end
    end)
end

-- Infinite Ammo
local function infiniteAmmo(state)
    infiniteAmmoEnabled = state
    spawn(function()
        while infiniteAmmoEnabled do
            wait(0.3)
            for _, tool in pairs(character:GetChildren()) do
                if tool:IsA("Tool") and tool:FindFirstChild("Ammo") or tool:FindFirstChild("Magazine") then
                    local ammo = tool:FindFirstChild("Ammo") or tool:FindFirstChild("Magazine")
                    if ammo and typeof(ammo) == "IntValue" or typeof(ammo) == "NumberValue" then
                        ammo.Value = 999
                    end
                end
            end
        end
    end)
end

-- Auto Complete Tasks (exemplo genérico - ajuste conforme remotes do jogo)
local function autoCompleteTasks(state)
    autoCompleteEnabled = state
    spawn(function()
        while autoCompleteEnabled do
            wait(1)
            -- Tenta completar tasks/objetivos genéricos
            for _, obj in pairs(workspace:GetDescendants()) do
                if obj.Name:lower():find("task") or obj.Name:lower():find("objective") or obj.Name:lower():find("generator") then
                    if obj:FindFirstChild("ProximityPrompt") then
                        fireproximityprompt(obj.ProximityPrompt, 0)
                    end
                end
            end
        end
    end)
end

-- ESP Simples
local function toggleESP(state)
    espEnabled = state
    -- Implementação básica de ESP (pode melhorar)
    if state then
        for _, v in pairs(workspace:GetDescendants()) do
            if v:FindFirstChild("Humanoid") and v ~= character then
                local highlight = Instance.new("Highlight")
                highlight.FillColor = Color3.fromRGB(255, 0, 0)
                highlight.OutlineColor = Color3.fromRGB(255, 255, 0)
                highlight.Parent = v
            end
        end
    else
        for _, v in pairs(workspace:GetDescendants()) do
            if v:FindFirstChild("Highlight") then
                v.Highlight:Destroy()
            end
        end
    end
end

-- Noclip
local function toggleNoclip(state)
    noclipEnabled = state
    spawn(function()
        while noclipEnabled do
            wait()
            for _, part in pairs(character:GetDescendants()) do
                if part:IsA("BasePart") and part.CanCollide then
                    part.CanCollide = false
                end
            end
        end
        -- Restaura quando desliga
        wait(0.5)
        for _, part in pairs(character:GetDescendants()) do
            if part:IsA("BasePart") then
                part.CanCollide = true
            end
        end
    end)
end

