Gun:CreateToggle({
    Name = "Munição Infinita",
    CurrentValue = false,
    Callback = function(state)
        if state then
            task.spawn(function()
                while state and task.wait(0.3) do
                    pcall(function()
                        local tool = player.Character and player.Character:FindFirstChildOfClass("Tool")
                        if tool then
                            for _, obj in pairs(tool:GetDescendants()) do
                                if obj:IsA("IntValue") or obj:IsA("NumberValue") then
                                    if obj.Name:lower():find("ammo") or obj.Name:lower():find("clip") or obj.Name == "Bullets" or obj.Name == "StoredAmmo" then
                                        obj.Value = 9999
                                    end
                                end
                            end
                            -- Alguns jogos usam Attributes
                            tool:SetAttribute("Ammo", 9999)
                            tool:SetAttribute("CurrentAmmo", 9999)
                        end
                    end)
                end
            end)
        end
    end
})

