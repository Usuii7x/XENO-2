-- Função para notificações elegantes
local function Notify(title, text, duration)
    local Fluent = require(game:GetService("CoreGui"):WaitForChild("FluentUI"))
    if Fluent and Fluent.Notify then
        Fluent:Notify({
            Title = title,
            Content = text,
            Duration = duration or 3
        })
    else
        warn("FluentUI não carregada, usando notificação padrão")
    end
end

