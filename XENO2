-- KILL AURA LOOP FUNCIONAL
local function GetCurrentWeapon()
    local char = LocalPlayer.Character
    if not char then return nil end
    for _, tool in pairs(char:GetChildren()) do
        if tool:IsA("Tool") and tool:FindFirstChild("Handle") then
            return tool
        end
    end
    return nil
end

local function AttackZombie(zombie, headshot)
    local tool = GetCurrentWeapon()
    if not tool then return end
    
    local targetPart = zombie:FindFirstChild("Head")
    if not targetPart or headshot then
        targetPart = zombie:FindFirstChild("HumanoidRootPart") or zombie:FindFirstChild("Torso")
    end
    if not targetPart then return end
    
    -- Simula ataque/disparo
    local remoteEvent = replicatedStorage:FindFirstChild("Damage")
    if remoteEvent then
        remoteEvent:FireServer(zombie, targetPart.Position)
    else
        -- Fallback: usar ClickDetector ou Tool ativo
        local humanoid = zombie:FindFirstChild("Humanoid")
        if humanoid and tool:FindFirstChild("Remote") then
            tool.Remote:FireServer(zombie)
        end
    end
end

task.spawn(function()
