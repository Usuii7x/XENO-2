-- Função para notificações
local function Notify(title, message, duration)
    Rayfield:Notify({
        Title = title,
        Content = message,
        Duration = duration or 3,
        Image = 0,
        Actions = {}
    })
end

-- Função para encontrar evomons próximos
local function FindNearestEvomon()
    local nearest = nil
    local minDist = math.huge
    for _, v in pairs(workspace:GetChildren()) do
        if v:IsA("Model") and v:FindFirstChild("Humanoid") and v.Name:find("Evomon") then
            local dist = (v.HumanoidRootPart.Position - Character.HumanoidRootPart.Position).Magnitude
            if dist < minDist then
                minDist = dist
                nearest = v
            end
        end
    end
    return nearest
end

-- Função para teleportar
local function TeleportTo(position)
    if Character and Character:FindFirstChild("HumanoidRootPart") then
        Character.HumanoidRootPart.CFrame = CFrame.new(position)
    end
end

